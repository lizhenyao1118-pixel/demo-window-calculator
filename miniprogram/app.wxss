page {
  background-color: #ffffff;
}
.container {
  padding: 24rpx;
}
.title {
  font-size: 40rpx;
  font-weight: 600;
  color: #333333;
  text-align: center;
  margin: 100rpx 0 60rpx;
}
.btn-primary {
  background-color: #07c160;
  color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
}
.section {
  margin-bottom: 32rpx;
}
.label {
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 12rpx;
}
.card {
  background-color: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
  padding: 24rpx;
}
