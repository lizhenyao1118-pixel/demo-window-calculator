<view class="page">
  <!-- 顶部用户区 -->
  <view class="header">
    <view class="avatar">
      <text class="avatar-text">李</text>
    </view>
    <view class="user-info">
      <text class="user-name">李Sir</text>
      <text class="user-role">独立门窗技术顾问</text>
    </view>
  </view>

  <!-- 菜单列表 -->
  <view class="menu-group">
    <view
      wx:for="{{menuList}}"
      wx:key="id"
      class="menu-item"
      data-id="{{item.id}}"
      data-ready="{{item.ready}}"
      bindtap="onMenuTap"
    >
      <text class="menu-icon">{{item.icon}}</text>
      <text class="menu-label">{{item.label}}</text>
      <view class="menu-right">
        <text wx:if="{{!item.ready}}" class="badge-soon">即将上线</text>
        <text class="arrow">›</text>
      </view>
    </view>
  </view>

  <view class="version">v1.0.0</view>
</view>
