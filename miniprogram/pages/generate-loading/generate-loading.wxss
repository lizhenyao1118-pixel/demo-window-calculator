.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  background: #FFFFFF;
  padding: 0 60rpx;
}

.loading-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 40rpx;
}

.spinner {
  width: 160rpx;
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.spinner-circle {
  width: 140rpx;
  height: 140rpx;
  border: 8rpx solid #E3F2FD;
  border-top-color: #1F4E79;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.loading-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
  text-align: center;
}

.loading-subtitle {
  font-size: 28rpx;
  color: #999999;
  text-align: center;
}
