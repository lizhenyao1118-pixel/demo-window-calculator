.container {
  padding-bottom: 40rpx;
  background: #F5F5F5;
  min-height: 100vh;
}

/* ===================== S4: 三段分组进度条 ===================== */
.group-progress-wrap {
  padding: 40rpx 32rpx 28rpx;
  background: #FFFFFF;
  margin-bottom: 20rpx;
}

.seg-bar {
  display: flex;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.seg {
  flex: 1;
  height: 8rpx;
  border-radius: 4rpx;
  overflow: hidden;
}

.seg-pending {
  background: #E0E4EA;
}
.seg-pending .seg-fill { width: 0; height: 100%; background: #1B3F72; }

.seg-active {
  background: #4A7FBF;
}
.seg-active .seg-fill {
  height: 100%;
  background: #1B3F72;
  transition: width 0.3s ease;
}

.seg-done {
  background: #1B3F72;
}
.seg-done .seg-fill { width: 100%; height: 100%; background: #1B3F72; }

.group-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.group-step-label {
  font-size: 24rpx;
  color: #999999;
}

.group-name-tag {
  font-size: 26rpx;
  color: #1F4E79;
  font-weight: 600;
}

.group-context {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.5;
  display: block;
}

/* ===================== S5: 题目卡片 ===================== */
.step {
  background: #FFFFFF;
  padding: 36rpx 32rpx 28rpx;
  border-radius: 8rpx;
  margin: 0 20rpx 20rpx;
}

/* ①标题 */
.q-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #333333;
  line-height: 1.4;
  margin-bottom: 12rpx;
}

/* ②辅助说明 */
.q-hint {
  display: block;
  font-size: 26rpx;
  color: #999999;
  line-height: 1.5;
  margin-bottom: 32rpx;
}

/* ③输入区外包 */
.input-area {
  /* 无额外样式，作为语义分层 */
}

/* ===================== 表单基础元素 ===================== */
.field-label {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.field-opt {
  font-size: 24rpx;
  color: #999999;
  font-weight: 400;
}

.req {
  color: #E53935;
  margin-left: 4rpx;
}

.mt24 { margin-top: 24rpx; }

.field-tip {
  display: block;
  font-size: 24rpx;
  color: #999999;
  margin-top: 12rpx;
}

/* Picker */
.picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 20rpx;
  border: 2rpx solid #E0E0E0;
  border-radius: 8rpx;
  background: #FFFFFF;
  color: #999999;
  font-size: 28rpx;
}

.picker-filled {
  border-color: #1F4E79;
  color: #333333;
}

.picker-arrow {
  font-size: 36rpx;
  color: #CCCCCC;
  line-height: 1;
}

/* Text input */
.text-input {
  display: block;
  width: 100%;
  padding: 24rpx 20rpx;
  border: 2rpx solid #E0E0E0;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #333333;
  background: #FFFFFF;
  box-sizing: border-box;
}

.input-placeholder {
  color: #CCCCCC;
}

/* ===================== S5: 标签多选组 ===================== */
.tag-group {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-group-wrap {
  flex-wrap: wrap;
}

.tag-item {
  padding: 14rpx 28rpx;
  border: 2rpx solid #E0E0E0;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #666666;
  background: #FFFFFF;
  transition: all 0.15s;
}

.tag-lg {
  padding: 16rpx 36rpx;
  font-size: 30rpx;
}

.tag-selected {
  border-color: #1F4E79;
  background: #E3F2FD;
  color: #1F4E79;
  font-weight: 600;
}

/* ===================== S5: Q2 楼层行 ===================== */
.floor-row {
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
  margin-bottom: 0;
}

.floor-field {
  flex: 1;
}

.floor-sep {
  font-size: 40rpx;
  color: #CCCCCC;
  padding-bottom: 16rpx;
  line-height: 1;
}

.ratio-badge {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
  padding: 12rpx 20rpx;
  background: #F5F5F5;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #666666;
}

.ratio-warn {
  color: #F9A825;
  font-size: 24rpx;
}

/* ===================== Q2: 风压警示 ===================== */
.wind-press-card {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 12rpx;
  border: 2rpx solid;
}

.wind-press-strong {
  background: #FFF5F5;
  border-color: #FFCECE;
}

.wind-press-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.wind-press-icon {
  font-size: 32rpx;
  color: #E53935;
}

.wind-press-title {
  font-size: 28rpx;
  color: #E53935;
  font-weight: 600;
}

.wind-press-text {
  display: block;
  font-size: 26rpx;
  color: #333333;
  line-height: 1.5;
}

.wind-press-hint {
  display: block;
  margin-top: 24rpx;
  padding: 16rpx 20rpx;
  background: #F5F5F5;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #999999;
  line-height: 1.5;
}

/* ===================== S5: Q5 遮阳卡片 ===================== */
.shading-block {
  margin-top: 24rpx;
}

.radio-card-group {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 12rpx;
}

.radio-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  border: 2rpx solid #E0E0E0;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #666666;
  background: #FFFFFF;
}

.radio-selected {
  border-color: #1F4E79;
  background: #E3F2FD;
  color: #1F4E79;
  font-weight: 600;
}

.radio-card-icon {
  font-size: 28rpx;
  color: #1F4E79;
}

/* ===================== S5: Q7 窗型卡片 ===================== */
.window-card-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.window-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  border: 2rpx solid #E0E0E0;
  border-radius: 8rpx;
  background: #FFFFFF;
  font-size: 30rpx;
  color: #333333;
}

.window-card-selected {
  border-color: #1F4E79;
  background: #E3F2FD;
  color: #1F4E79;
  font-weight: 600;
}

.window-card-label {
  flex: 1;
}

.window-card-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #1F4E79;
  color: #FFFFFF;
  font-size: 24rpx;
  text-align: center;
  line-height: 40rpx;
}

/* ===================== S5: Q8 勾选列表 ===================== */
.check-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.check-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 24rpx;
  border: 2rpx solid #E0E0E0;
  border-radius: 8rpx;
  background: #FFFFFF;
}

.check-selected {
  border-color: #1F4E79;
  background: #E3F2FD;
}

.check-box {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #CCCCCC;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: #FFFFFF;
}

.check-selected .check-box {
  background: #1F4E79;
  border-color: #1F4E79;
}

.check-mark {
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
}

.check-label {
  font-size: 28rpx;
  color: #333333;
  flex: 1;
  line-height: 1.4;
}

.check-selected .check-label {
  color: #1F4E79;
  font-weight: 500;
}

/* ===================== S5: Q9 预算档位提示 ===================== */
.budget-hint-card {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  background: #EEF3FA;
  border-left: 4rpx solid #1B3F72;
  border-radius: 8rpx;
}

.budget-hint-icon {
  font-size: 28rpx;
  flex-shrink: 0;
}

.budget-hint-text {
  font-size: 26rpx;
  color: #1B3F72;
  line-height: 1.5;
}

/* ===================== 内联提示条 ===================== */
.inline-tip {
  display: block;
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  line-height: 1.5;
}

.warn-tip {
  background: #FFF8EC;
  color: #8B6200;
  border-left: 4rpx solid #E6A817;
}

.info-tip {
  background: #EEF3FA;
  color: #1B3F72;
  border-left: 4rpx solid #1B3F72;
}

/* ===================== Q1: 城市参数卡片 ===================== */
.city-hint {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #EEF3FA;
  border-left: 4rpx solid #1B3F72;
  border-radius: 8rpx;
}

.city-hint-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1B3F72;
  margin-bottom: 16rpx;
}

.city-hint-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.city-hint-label {
  font-size: 26rpx;
  color: #666666;
}

.city-hint-value {
  font-size: 26rpx;
  color: #333333;
  font-weight: 500;
}

.city-hint-note {
  display: block;
  font-size: 24rpx;
  color: #999999;
  margin-top: 12rpx;
  font-style: italic;
  line-height: 1.4;
}

/* ===================== Q9: 冲突预警 ===================== */
.conflict-card {
  background: #FFF5F5;
  border: 2rpx solid #FFCECE;
  border-radius: 12rpx;
  padding: 28rpx;
  margin-top: 24rpx;
}

.conflict-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.conflict-icon {
  font-size: 32rpx;
}

.conflict-title {
  color: #E53935;
  font-size: 32rpx;
  font-weight: 600;
}

.conflict-desc {
  display: block;
  color: #333333;
  font-size: 28rpx;
  line-height: 1.6;
  margin-bottom: 8rpx;
}

.conflict-std {
  display: block;
  color: #999999;
  font-size: 24rpx;
  margin-bottom: 24rpx;
}

.conflict-actions {
  border-top: 1rpx solid #F0E0E0;
}

.conflict-action-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0E0E0;
  color: #1F4E79;
  font-size: 28rpx;
}

.btn-risk {
  background: #E53935;
  color: #FFFFFF;
  margin-top: 24rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  width: 100%;
  border: none;
}

/* ===================== S4: 底部导航栏 ===================== */
.nav-bar {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx;
  background: #FFFFFF;
  margin: 0 20rpx 20rpx;
  border-radius: 8rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.btn-prev-new {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #F5F5F5;
  color: #666666;
  border-radius: 8rpx;
  font-size: 30rpx;
  border: none;
}

.btn-next-new {
  flex: 2;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #1F4E79;
  color: #FFFFFF;
  border-radius: 8rpx;
  font-size: 30rpx;
  border: none;
}

.btn-disabled {
  background: #CCCCCC !important;
  color: #FFFFFF !important;
}

.btn-placeholder {
  flex: 1;
}

/* ===================== 底部提示 ===================== */
.draft-tip {
  text-align: center;
  color: #CCCCCC;
  font-size: 24rpx;
  margin: 8rpx 0 40rpx;
}

/* ===================== S6: 确认页 ===================== */
.confirm-step {
  background: #FFFFFF;
}

.confirm-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280rpx, 1fr));
  gap: 24rpx;
  margin-top: 32rpx;
}

.confirm-item {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 24rpx;
  background: #F5F5F5;
  border-radius: 8rpx;
}

.confirm-item-full {
  grid-column: span 2;
}

.confirm-label {
  font-size: 26rpx;
  color: #999999;
  font-weight: 500;
}

.confirm-value {
  font-size: 32rpx;
  color: #333333;
  font-weight: 600;
}

.confirm-tips {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 32rpx;
  padding: 20rpx 24rpx;
  background: #FFF5F5;
  border-left: 6rpx solid #E53935;
  border-radius: 8rpx;
}

.confirm-tip-icon {
  font-size: 32rpx;
}

.confirm-tip-text {
  font-size: 28rpx;
  color: #E53935;
  font-weight: 500;
}
