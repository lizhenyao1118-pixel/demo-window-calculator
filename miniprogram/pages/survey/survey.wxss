.container {
  padding: 20px;
  background: #f5f5f5;
  min-height: 100vh;
}

.progress-bar {
  height: 4px;
  background: #e0e0e0;
  border-radius: 2px;
  margin-bottom: 30px;
  position: relative;
}

.progress-fill {
  height: 100%;
  background: #07c160;
  border-radius: 2px;
  transition: width 0.3s;
}

.progress-text {
  position: absolute;
  right: 0;
  top: -20px;
  font-size: 12px;
  color: #999;
}

.step {
  background: white;
  padding: 20px;
  border-radius: 8px;
  margin-bottom: 20px;
}

.question-title {
  font-size: 18px;
  font-weight: bold;
  margin-bottom: 20px;
  color: #333;
}

.picker, .input {
  padding: 12px;
  border: 1px solid #ddd;
  border-radius: 4px;
  margin-bottom: 15px;
  background: white;
}

.input.short {
  width: 100px;
  display: inline-block;
}

.city-hint {
  background: #e6f7f0;
  border-left: 4px solid #07c160;
  padding: 15px;
  margin-top: 20px;
  border-radius: 4px;
}

.hint-title {
  font-weight: bold;
  color: #07c160;
  margin-bottom: 10px;
}

.hint-item {
  font-size: 14px;
  color: #666;
  margin: 5px 0;
}

.hint-note {
  font-size: 12px;
  color: #999;
  margin-top: 10px;
  font-style: italic;
}

.pain-points {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.pain-point-item {
  padding: 12px 20px;
  border: 1px solid #ddd;
  border-radius: 20px;
  background: white;
  transition: all 0.2s;
}

.pain-point-item.selected {
  background: #07c160;
  color: white;
  border-color: #07c160;
}

.nav-buttons {
  display: flex;
  gap: 10px;
  margin-top: 30px;
}

.btn-next, .btn-submit {
  background: #07c160;
  color: white;
  flex: 1;
}

.btn-prev {
  background: #f0f0f0;
  color: #666;
  width: 100px;
}

.draft-tip {
  text-align: center;
  color: #999;
  font-size: 12px;
  margin-top: 20px;
}

/* 冲突预警（红色警告） */
.conflict-warning {
  background: #fff2f0;
  border: 1px solid #ffccc7;
  color: #cf1322;
  padding: 12px;
  border-radius: 4px;
  margin-top: 15px;
  font-size: 14px;
  line-height: 1.5;
}

/* 单选组样式 */
.radio-group {
  margin-top: 15px;
  padding: 10px;
  background: #f9f9f9;
  border-radius: 4px;
}

.radio-group label {
  display: block;
  margin: 8px 0;
  font-size: 14px;
}

/* 危险/警告按钮样式 */
.btn-danger {
  background: #ff4d4f !important;
  color: white !important;
  animation: shake 0.5s; /* 可选：抖动动画提醒 */
}

@keyframes shake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-5px); }
  75% { transform: translateX(5px); }
}

.risk-option {
  display: block;
  margin: 10px 0;
}

.btn-primary {
  background: #07c160;
  color: white;
  margin-top: 30px;
  width: 100%;
}

.conflict-card { background:#fff5f5; border:2rpx solid #ffcece; border-radius:16rpx; padding:32rpx; margin-top:32rpx; }
.conflict-header { display:flex; align-items:center; margin-bottom:16rpx; }
.conflict-title { color:#fa5151; font-size:32rpx; font-weight:600; margin-left:12rpx; }
.conflict-desc { color:#333; font-size:28rpx; line-height:1.6; display:block; margin-bottom:8rpx; }
.conflict-std { color:#999; font-size:24rpx; display:block; margin-bottom:24rpx; }
.suggestion-item { padding:16rpx 0; border-bottom:1rpx solid #f0f0f0; color:#07c160; }
.btn-risk { background:#fa5151; color:white; margin-top:32rpx; border-radius:8rpx; }

.options-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 16px;
  border: 1px solid #e5e5e5;
  border-radius: 8px;
  background: #ffffff;
}

.option.selected {
  border-color: #07c160;
  background: #e6f7f0;
}

.warning-hint {
  margin-top: 12px;
  color: #fa5151;
  font-size: 14px;
  display: flex;
  align-items: center;
  gap: 6px;
}

.height-ratio-display {
  margin-top: 12px;
  padding: 10px 12px;
  background: #f5f5f5;
  border-radius: 8px;
  font-size: 14px;
}

.ratio-value {
  color: #07c160;
  font-weight: 600;
  margin: 0 4px;
}

.ratio-hint {
  color: #fa5151;
  font-size: 12px;
}

.checkbox-item {
  display: flex;
  align-items: center;
  padding: 12px;
  margin-bottom: 8px;
  background: #fff;
  border: 1px solid #e0e0e0;
  border-radius: 8px;
  transition: all 0.2s;
}

.checkbox-item.selected {
  border-color: #07c160;
  background: #f0fff4;
}

.checkbox-item checkbox {
  margin-right: 8px;
}

.checkbox-text {
  font-size: 15px;
  color: #333;
}

.risk-option {
  display: flex;
  align-items: center;
  padding: 12px;
  margin-bottom: 8px;
  background: #fff;
  border: 1px solid #e0e0e0;
  border-radius: 8px;
}

.risk-option.selected {
  border-color: #07c160;
  background: #f0fff4;
}

.risk-option checkbox {
  margin-right: 8px;
}

.option-text {
  font-size: 15px;
  color: #333;
}
