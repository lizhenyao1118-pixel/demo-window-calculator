<view class="container">

  <!-- S4: 三段分组进度条 + 组信息 -->
  <view class="group-progress-wrap">
    <view class="seg-bar">
      <view
        wx:for="{{groupProgress}}"
        wx:key="index"
        class="seg seg-{{item.state}}"
      >
        <view class="seg-fill" style="width: {{item.percent}}%"></view>
      </view>
    </view>
    <view class="group-meta" wx:if="{{currentStep < 9}}">
      <text class="group-step-label">第{{groupIndex+1}}组 · {{stepInGroup+1}}/3</text>
      <text class="group-name-tag">{{groupName}}</text>
    </view>
    <view class="group-meta" wx:if="{{currentStep === 9}}">
      <text class="group-name-tag">{{groupName}}</text>
    </view>
    <text class="group-context">{{groupContext}}</text>
  </view>

  <!-- Q1: 城市 -->
  <view class="step" wx:if="{{currentStep === 0}}">
    <!-- ①标题 -->
    <text class="q-title">您的房子在哪个城市？</text>
    <!-- ②辅助说明 -->
    <text class="q-hint">不同城市气候和风压差异大，直接影响窗户参数标准</text>
    <!-- ③输入区 -->
    <view class="input-area">
      <view class="field-label">所在城市 <text class="req">*</text></view>
      <picker
        wx:if="{{cityList && cityList.length > 0}}"
        mode="selector"
        range="{{cityList}}"
        bindchange="onCityChange">
        <view class="picker {{formData.city ? 'picker-filled' : ''}}">
          <text>{{formData.city || '请选择城市'}}</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
      <view wx:else class="picker">数据加载中...</view>

      <view class="field-label mt24">所在行政区 <text class="field-opt">（选填）</text></view>
      <input
        class="text-input"
        placeholder="如：朝阳区、南山区"
        placeholder-class="input-placeholder"
        value="{{formData.district}}"
        bindinput="onDistrictInput"
      />

      <view class="city-hint" wx:if="{{cityHint}}">
        <view class="city-hint-title">{{formData.city}} 参考基准</view>
        <view class="city-hint-row">
          <text class="city-hint-label">抗风压</text>
          <text class="city-hint-value">P3 {{cityHint.p3}} kPa</text>
        </view>
        <view class="city-hint-row">
          <text class="city-hint-label">隔声量</text>
          <text class="city-hint-value">Rw {{cityHint.rw}} dB</text>
        </view>
        <view class="city-hint-row">
          <text class="city-hint-label">传热系数</text>
          <text class="city-hint-value">K {{cityHint.k}}</text>
        </view>
        <text class="city-hint-note">{{cityHint.note}}</text>
      </view>
    </view>
  </view>

  <!-- Q2: 楼层 -->
  <view class="step" wx:if="{{currentStep === 1}}">
    <!-- ①标题 -->
    <text class="q-title">您住在几楼？窗户用在哪些房间？</text>
    <!-- ②辅助说明 -->
    <text class="q-hint">楼层越高风压越大，不同房间对隔音隔热要求不同</text>
    <!-- ③输入区 -->
    <view class="input-area">
      <view class="floor-row">
        <view class="floor-field">
          <view class="field-label">所在楼层 <text class="req">*</text></view>
          <input
            type="number"
            class="text-input"
            placeholder="如 18"
            placeholder-class="input-placeholder"
            value="{{formData.floor}}"
            bindinput="onFloorChange"
          />
        </view>
        <view class="floor-sep">/</view>
        <view class="floor-field">
          <view class="field-label">总楼层 <text class="req">*</text></view>
          <input
            type="number"
            class="text-input"
            placeholder="如 33"
            placeholder-class="input-placeholder"
            value="{{formData.totalFloors}}"
            bindinput="onTotalFloorsChange"
          />
        </view>
      </view>

      <view wx:if="{{showHeightRatio}}" class="ratio-badge">
        <text>当前位置 {{heightRatio}}%</text>
        <text wx:if="{{heightRatio >= 80}}" class="ratio-warn">高层区域，风压要求较高</text>
      </view>

      <!-- 强警示（红色卡片） -->
      <view wx:if="{{windPressureLevel === 'strong'}}" class="wind-press-card wind-press-strong">
        <view class="wind-press-header">
          <text class="wind-press-icon">⚠</text>
          <text class="wind-press-title">高区位置风压风险</text>
        </view>
        <text class="wind-press-text">高层高区风压载荷较大，型材主受力要求相应提高。</text>
      </view>

      <!-- 弱提示（灰色文字） -->
      <view wx:if="{{windPressureLevel === 'weak'}}" class="wind-press-hint">
        <text>您的楼层属于高层区，风压较中低层更大，建议优先选择抗风压性能更好的型材和玻璃配置。</text>
      </view>

      <view class="field-label mt24">使用场景 <text class="req">*</text></view>
      <view class="tag-group">
        <view
          wx:for="{{roomTypeOptions}}"
          wx:for-item="item"
          wx:key="value"
          class="tag-item {{roomTypeSelectedMap[item.value] ? 'tag-selected' : ''}}"
          bindtap="onRoomTypeChange"
          data-value="{{item.value}}"
        >{{item.label}}</view>
      </view>
      <text class="field-tip">可多选</text>
    </view>
  </view>

  <!-- Q3: 痛点 -->
  <view class="step" wx:if="{{currentStep === 2}}">
    <!-- ①标题 -->
    <text class="q-title">以下哪些问题最困扰您？</text>
    <!-- ②辅助说明 -->
    <text class="q-hint">您的关注点会影响参数的优先级和加严方向</text>
    <!-- ③输入区 -->
    <view class="input-area">
      <view class="tag-group tag-group-wrap">
        <view
          wx:for="{{painPoints}}"
          wx:for-item="item"
          wx:key="value"
          class="tag-item tag-lg {{painPointSelectedMap[item.value] ? 'tag-selected' : ''}}"
          bindtap="onPainPointTap"
          data-value="{{item.value}}"
        >{{item.label}}</view>
      </view>
      <text class="field-tip">至少选1项，可多选</text>
    </view>
  </view>

  <!-- Q4: 噪音 -->
  <view class="step" wx:if="{{currentStep === 3}}">
    <!-- ①标题 -->
    <text class="q-title">您家附近有什么噪声源？</text>
    <!-- ②辅助说明 -->
    <text class="q-hint">噪声类型和距离决定隔音等级，直接影响玻璃配置</text>
    <!-- ③输入区 -->
    <view class="input-area">
      <view class="field-label">噪声类型 <text class="req">*</text></view>
      <picker mode="selector" range="{{noiseTypeOptions}}" range-key="label" bindchange="onNoiseTypeChange">
        <view class="picker {{formData.noise_type ? 'picker-filled' : ''}}">
          <text>{{formData.noise_type_label || '请选择噪声类型'}}</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>

      <view class="field-label mt24" wx:if="{{formData.noise_type !== 'quiet' && formData.noise_type !== 'silent' && formData.noise_type !== 'none'}}">与噪声源距离 <text class="req">*</text></view>
      <picker wx:if="{{formData.noise_type !== 'quiet' && formData.noise_type !== 'silent' && formData.noise_type !== 'none'}}" mode="selector" range="{{noiseDistOptions}}" range-key="label" bindchange="onNoiseDistChange">
        <view class="picker {{formData.noise_dist ? 'picker-filled' : ''}}">
          <text>{{formData.noise_dist_label || '请选择距离范围'}}</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
      <view wx:else class="field-note">安静环境无需选择距离范围</view>

      <view class="inline-tip warn-tip" wx:if="{{formData.noise_type === 'main_road' && formData.noise_dist === 'lt20'}}">
        主干道近距离噪声强，本案隔声量目标值 Rw ≥ 41 dB
      </view>
    </view>
  </view>

  <!-- Q5: 朝向 -->
  <view class="step" wx:if="{{currentStep === 4}}">
    <!-- ①标题 -->
    <text class="q-title">主要窗户朝哪个方向？</text>
    <!-- ②辅助说明 -->
    <text class="q-hint">西向/西南向窗户日晒强烈，需要考虑隔热和遮阳</text>
    <!-- ③输入区 -->
    <view class="input-area">
      <view class="field-label">房屋朝向 <text class="req">*</text></view>
      <picker mode="selector" range="{{orientations}}" bindchange="onOrientationChange">
        <view class="picker {{formData.orientation ? 'picker-filled' : ''}}">
          <text>{{formData.orientation || '请选择朝向'}}</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>

      <view wx:if="{{formData.orientation}}" class="shading-block">
        <view class="field-label">是否有西晒遮挡？</view>
        <view class="radio-card-group">
          <view
            class="radio-card {{!formData.westShading ? 'radio-selected' : ''}}"
            bindtap="onShadingTap"
            data-value="false"
          >
            <text class="radio-card-icon">{{!formData.westShading ? '●' : '○'}}</text>
            <text>无遮挡（西晒严重）</text>
          </view>
          <view
            class="radio-card {{formData.westShading ? 'radio-selected' : ''}}"
            bindtap="onShadingTap"
            data-value="true"
          >
            <text class="radio-card-icon">{{formData.westShading ? '●' : '○'}}</text>
            <text>有遮挡 / 幕墙</text>
          </view>
        </view>
      </view>

      <view class="inline-tip warn-tip" wx:if="{{(formData.orientation === '西' || formData.orientation === '西南') && !formData.westShading}}">
        {{formData.orientation}}向无遮挡，夏季空调负荷增加约 30%，建议 SHGC ≤ 0.4
      </view>
    </view>
  </view>

  <!-- Q6: 供暖 -->
  <view class="step" wx:if="{{currentStep === 5}}">
    <!-- ①标题 -->
    <text class="q-title">您家冬天怎么取暖？</text>
    <!-- ②辅助说明 -->
    <text class="q-hint">取暖方式影响窗户保温要求，有供暖的房子 K 值标准会更严格</text>
    <!-- ③输入区 -->
    <view class="input-area">
      <view class="field-label">取暖方式 <text class="req">*</text></view>
      <picker mode="selector" range="{{heatingTypes}}" bindchange="onHeatingChange">
        <view class="picker {{formData.heatingType ? 'picker-filled' : ''}}">
          <text>{{formData.heatingType || '请选择取暖方式'}}</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
      <view class="inline-tip info-tip" wx:if="{{formData.heatingType === '集中供暖'}}">
        {{heatingCentralKTip}}
      </view>
      <view class="inline-tip info-tip" wx:if="{{formData.heatingType === '自采暖'}}">
        {{heatingSelfKTip}}
      </view>
      <view class="inline-tip info-tip" wx:if="{{formData.heatingType === '无供暖'}}">
        {{heatingNoneKTip}}
      </view>
    </view>
  </view>

  <!-- Q7: 窗型 -->
  <view class="step" wx:if="{{currentStep === 6}}">
    <!-- ①标题 -->
    <text class="q-title">您想用哪种窗户？</text>
    <!-- ②辅助说明 -->
    <text class="q-hint">不确定也没关系，不同窗型在隔音、通风、密封性上各有优劣</text>
    <!-- ③输入区 -->
    <view class="input-area">
      <view class="window-card-list">
        <view
          wx:for="{{windowTypes}}"
          wx:key="value"
          class="window-card {{formData.window_type === item.value ? 'window-card-selected' : ''}}"
          bindtap="selectWindowType"
          data-value="{{item.value}}"
        >
          <text class="window-card-label">{{item.label}}</text>
          <view class="window-card-check" wx:if="{{formData.window_type === item.value}}">✓</view>
        </view>
      </view>

      <view class="inline-tip warn-tip" wx:if="{{formData.window_type === 'sliding' || formData.window_type === 'door_window'}}">
        推拉窗/门联窗气密性较低，需提供整窗测试报告（GB/T 7106）
      </view>
    </view>
  </view>

  <!-- Q8: 家庭风险 -->
  <view class="step" wx:if="{{currentStep === 7}}">
    <!-- ①标题 -->
    <text class="q-title">您家有以下情况吗？</text>
    <!-- ②辅助说明 -->
    <text class="q-hint">这些信息关系到玻璃安全等级，涉及国标强制要求</text>
    <!-- ③输入区 -->
    <view class="input-area">
      <view class="check-list">
        <view
          wx:for="{{riskOptions}}"
          wx:for-item="item"
          wx:key="value"
          class="check-item {{familyRiskSelectedMap[item.value] ? 'check-selected' : ''}}"
          bindtap="onFamilyRiskTap"
          data-value="{{item.value}}"
        >
          <view class="check-box">
            <text wx:if="{{familyRiskSelectedMap[item.value]}}" class="check-mark">✓</text>
          </view>
          <text class="check-label">{{item.label}}</text>
        </view>
      </view>
      <text class="field-tip">可多选，至少选1项</text>

      <view class="inline-tip warn-tip" wx:if="{{familyRiskSelectedMap['child'] && familyRiskSelectedMap['large_fixed']}}">
        有儿童 + 落地窗，国标（GB 15763.3）强制使用夹胶安全玻璃
      </view>
    </view>
  </view>

  <!-- Q9: 预算 -->
  <view class="step" wx:if="{{currentStep === 8}}">
    <!-- ①标题 -->
    <text class="q-title">您的预算大概在什么范围？</text>
    <!-- ②辅助说明 -->
    <text class="q-hint">预算影响型材档次和玻璃配置的推荐方案</text>
    <!-- ③输入区 -->
    <view class="input-area">
      <view class="field-label">预算档位 <text class="req">*</text></view>
      <picker mode="selector" range="{{budgetTiers}}" range-key="label" bindchange="onBudgetChange">
        <view class="picker {{formData.budgetTier ? 'picker-filled' : ''}}">
          <text>{{selectedBudgetLabel || '请选择预算档位'}}</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>

      <view class="budget-hint-card" wx:if="{{selectedBudgetHint}}">
        <text class="budget-hint-icon">💰</text>
        <text class="budget-hint-text">{{selectedBudgetHint}}</text>
      </view>

      <view wx:if="{{showConflictWarning}}" class="conflict-card">
        <view class="conflict-header">
          <text class="conflict-icon">⚠️</text>
          <text class="conflict-title">配置不兼容</text>
        </view>
        <text class="conflict-desc">{{conflictMessage}}</text>
        <text class="conflict-std">GB/T 7106 要求抗风压 ≥ 3.5 kPa</text>

        <view class="conflict-actions">
          <view class="conflict-action-item" bindtap="upgradeToTierB">
            ① 升级至 B 档（推荐）
          </view>
          <view class="conflict-action-item" bindtap="adjustFloor">
            ② 修改楼层数据
          </view>
        </view>

        <button class="btn-risk" bindtap="forceRisk">了解风险，继续生成</button>
      </view>
    </view>
  </view>

  <!-- S6: 确认页（step 9） -->
  <view class="step confirm-step" wx:if="{{currentStep === 9}}">
    <text class="q-title">确认您的需求</text>
    <text class="q-hint">请核对以下信息，确认无误后生成招标文件</text>

    <view class="confirm-grid">
      <view class="confirm-item">
        <text class="confirm-label">城市</text>
        <text class="confirm-value">{{formData.city}}</text>
      </view>
      <view class="confirm-item">
        <text class="confirm-label">区域</text>
        <text class="confirm-value">{{formData.district || '-'}}</text>
      </view>
      <view class="confirm-item">
        <text class="confirm-label">楼层</text>
        <text class="confirm-value">{{formData.floor}}/{{formData.totalFloors}}层</text>
      </view>
      <view class="confirm-item">
        <text class="confirm-label">使用场景</text>
        <text class="confirm-value">{{confirmRoomTypeLabels}}</text>
      </view>
      <view class="confirm-item">
        <text class="confirm-label">最关注</text>
        <text class="confirm-value">{{confirmFirstPainPointLabel}}</text>
      </view>
      <view class="confirm-item">
        <text class="confirm-label">噪声源</text>
        <text class="confirm-value">{{formData.noise_type_label}} · {{formData.noise_dist_label}}</text>
      </view>
      <view class="confirm-item">
        <text class="confirm-label">朝向</text>
        <text class="confirm-value">{{formData.orientation}}{{formData.westShading ? ' · 有遮挡' : ''}}</text>
      </view>
      <view class="confirm-item">
      </view>
      <view class="confirm-item">
        <text class="confirm-label">取暖方式</text>
        <text class="confirm-value">{{formData.heatingType}}</text>
      </view>
      <view class="confirm-item">
        <text class="confirm-label">窗型</text>
        <text class="confirm-value">{{confirmWindowTypeLabel}}</text>
      </view>
      <view class="confirm-item confirm-item-full">
        <text class="confirm-label">安全风险</text>
        <text class="confirm-value">{{confirmFamilyRiskLabels}}</text>
      </view>
      <view class="confirm-item">
        <text class="confirm-label">预算</text>
        <text class="confirm-value">{{selectedBudgetLabel}}</text>
      </view>
    </view>

    <view class="confirm-tips" wx:if="{{showConflictWarning}}">
      <text class="confirm-tip-icon">⚠️</text>
      <text class="confirm-tip-text">配置存在风险，将生成风险版文件</text>
    </view>
  </view>

  <!-- S6: 底部导航栏 -->
  <view class="nav-bar">
    <button
      wx:if="{{currentStep > 0 && currentStep <= 8}}"
      class="btn-prev-new"
      bindtap="prevStep"
    >上一题</button>
    <button
      wx:if="{{currentStep === 9}}"
      class="btn-prev-new"
      bindtap="backToStep8"
    >返回修改</button>
    <view wx:else class="btn-placeholder"></view>

    <button
      wx:if="{{currentStep < 8}}"
      class="btn-next-new"
      bindtap="nextStep"
    >下一题</button>
    <button
      wx:if="{{currentStep === 8 && !showConflictWarning}}"
      class="btn-next-new {{!formData.budgetTier ? 'btn-disabled' : ''}}"
      bindtap="goToConfirm"
      disabled="{{!formData.budgetTier}}"
    >下一步</button>
    <button
      wx:if="{{currentStep === 9}}"
      class="btn-next-new"
      bindtap="submitWithLoading"
    >确认无误，生成招标文件</button>
  </view>

  <view class="draft-tip">已自动保存草稿</view>
</view>
