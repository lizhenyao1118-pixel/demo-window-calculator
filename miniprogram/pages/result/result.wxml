<scroll-view scroll-y class="page">

  <!-- L1 摘要卡：始终可见 -->
  <view class="cover-card">
    <text class="cover-sub">门窗需求定制招标文件</text>
    <text class="cover-title">{{cover.city}}</text>
    <text class="cover-sub">{{cover.floorDesc}}</text>
    <text class="cover-date">生成于 {{cover.issueDate}}</text>
  </view>

  <view class="section-label">关键参数指标</view>
  <view class="param-grid">
    <view class="param-card">
      <text class="param-label">保温</text>
      <text class="param-symbol">≤</text>
      <text class="param-value">{{summary.k_target}}</text>
      <text class="param-unit">W/(m²·K) · K值</text>
    </view>
    <view class="param-card">
      <text class="param-label">隔音</text>
      <text class="param-symbol">≥</text>
      <text class="param-value">{{summary.rw_required}}</text>
      <text class="param-unit">dB · Rw值</text>
    </view>
    <view class="param-card">
      <text class="param-label">遮阳</text>
      <text class="param-symbol">≤</text>
      <text class="param-value">{{summary.shgc_target || '—'}}</text>
      <text class="param-unit">SHGC</text>
    </view>
    <view class="param-card">
      <text class="param-label">抗风压</text>
      <text class="param-symbol">≥</text>
      <text class="param-value">{{summary.p3_required}}kPa</text>
      <text class="param-unit">{{summary.wind_zone}}</text>
    </view>
    <view class="param-card">
      <text class="param-label">密封性能</text>
      <text class="param-symbol">—</text>
      <text class="param-value">气密{{summary.air_rec}}级 / 水密{{summary.water_rec}}级</text>
      <text class="param-unit">综合反映安装工艺质量</text>
    </view>
    <view class="param-card">
      <text class="param-label">安全</text>
      <text class="param-symbol">—</text>
      <text class="param-value" style="font-size:14px;">需专项核查</text>
      <text class="param-unit">查看完整报告</text>
    </view>
  </view>

  <!-- 付费按钮：未解锁时可见 -->
  <view wx:if="{{!isPaid}}" class="unlock-btn" bindtap="onUnlock">
    <text class="unlock-btn-text">¥99 限时免费，直接发给商家比价</text>
    <text class="unlock-btn-sub">含完整技术参数与验收标准，商家看到就知道你懂行</text>
  </view>

  <!-- 四章内容：仅付费后渲染 -->
  <view wx:if="{{isPaid}}" class="chapters-wrap">

    <!-- ===== 第一章 ===== -->
    <view class="chapter-header">
      <text class="chapter-num">第一章</text>
      <text class="chapter-title">性能需求诊断</text>
    </view>

    <!-- M1-1 项目身份信息 -->
    <view class="info-grid">
      <view class="info-row">
        <text class="info-key">城市 / 气候区</text>
        <text class="info-val">{{chapter1.basicInfo.city}} · {{chapter1.basicInfo.climateLabel}}</text>
      </view>
      <view class="info-row">
        <text class="info-key">楼层</text>
        <text class="info-val">{{chapter1.basicInfo.floorDesc}}</text>
      </view>
      <view class="info-row">
        <text class="info-key">朝向 / 窗型</text>
        <text class="info-val">{{chapter1.basicInfo.orientation}} · {{chapter1.basicInfo.windowType}}</text>
      </view>
      <view class="info-row">
        <text class="info-key">供暖方式</text>
        <text class="info-val">{{chapter1.basicInfo.heatingType}}</text>
      </view>
      <view class="info-row">
        <text class="info-key">家庭构成</text>
        <text class="info-val">{{chapter1.basicInfo.familyDesc}}</text>
      </view>
      <view class="info-row">
        <text class="info-key">核心诉求</text>
        <text class="info-val info-tag">{{chapter1.basicInfo.painPoint}}</text>
      </view>
    </view>

    <!-- M1-2 核心诉求声明 -->
    <view class="tension-block">
      <text class="tension-text">{{chapter1.needsAnalysis.coreTension}}</text>
    </view>

    <!-- M1-3 性能参数三层 -->
    <view class="needs-card" wx:for="{{chapter1.needsAnalysis.needsTable}}" wx:key="dimension">
      <view class="needs-header">
        <text class="needs-dimension">{{item.dimension}}</text>
        <text class="needs-value">{{item.value}}</text>
      </view>
      <text class="needs-derivation">{{item.derivation}}</text>
      <view wx:if="{{item.levelBar}}" class="level-bar-wrap">
        <view class="level-bar-track">
          <view class="level-bar-fill" style="width:{{item.levelBar._barPosition}}"></view>
          <view class="level-bar-marker" style="left:{{item.levelBar._barPosition}}"></view>
        </view>
        <view class="level-bar-labels">
          <text class="level-label-low">{{item.levelBar.lowLabel}}</text>
          <text class="level-label-high">{{item.levelBar.highLabel}}</text>
        </view>
        <view class="level-bar-mid-row">
          <text class="level-mid-hint" style="left:{{item.levelBar._barPosition}}">本案要求 {{item.levelBar.midValue}}{{item.levelBar.unit}}</text>
        </view>
      </view>
      <view wx:if="{{item.marketReality}}" class="market-reality">
        <text class="market-tag {{item.marketReality.tag === '普遍可达' ? 'tag-green' : 'tag-orange'}}">{{item.marketReality.tag}}</text>
        <text class="market-desc">{{item.marketReality.description}}</text>
      </view>
    </view>

    <!-- M1-4 强制条款提示 -->
    <view wx:if="{{chapter1.needsAnalysis.budgetFitnessNote}}" class="upgrade-block">
      <text class="upgrade-item">{{chapter1.needsAnalysis.budgetFitnessNote.text}}</text>
    </view>

    <!-- ===== 第二章 ===== -->
    <view class="chapter-header">
      <text class="chapter-num">第二章</text>
      <text class="chapter-title">采购技术底线</text>
    </view>

    <!-- M2-1 定位说明 -->
    <text class="position-statement">{{chapter2.positionStatement}}</text>

    <!-- M2-2 技术指标表 -->
    <view class="table-wrap">
      <view class="table-head">
        <text class="col-a">配置项</text>
        <text class="col-b">最低规格</text>
        <text class="col-c">验证方式</text>
      </view>
      <view class="table-row {{index % 2 === 1 ? 'alt' : ''}}"
            wx:for="{{chapter2.metrics}}" wx:key="name">
        <text class="col-a th">{{item.name}}</text>
        <text class="col-b">{{item.value}}</text>
        <text class="col-c">{{item.std}}</text>
      </view>
    </view>

    <!-- M2-3 商家回应识别提示 -->
    <view wx:if="{{chapter2.responseGuide}}" class="response-guide">
      <view class="response-item">
        <text class="response-icon response-ok">✓</text>
        <text class="response-text">{{chapter2.responseGuide.complete}}</text>
      </view>
      <view class="response-item">
        <text class="response-icon response-warn">△</text>
        <text class="response-text">{{chapter2.responseGuide.evasion}}</text>
      </view>
      <view class="response-item">
        <text class="response-icon response-bad">✕</text>
        <text class="response-text">{{chapter2.responseGuide.reject}}</text>
      </view>
    </view>

    <!-- ===== 第三章 ===== -->
    <view class="chapter-header">
      <text class="chapter-num">第三章</text>
      <text class="chapter-title">红线清单</text>
    </view>

    <!-- M3-1 章节定位说明 -->
    <text class="chapter-intro">以下红线由第一章性能诊断结果动态生成，每条对应一项可量化指标。任何一项不满足，即视为方案不合格，无需进入比价环节。</text>

    <!-- M3-2 禁止项清单 + 用户侧含义 -->
    <view class="redline-list">
      <view class="redline-item" wx:for="{{chapter3.redlineChecklist.mandatory}}" wx:key="index">
        <view class="redline-dot"></view>
        <view class="redline-content">
          <text class="redline-title">{{item.text}}</text>
        </view>
      </view>
      <view class="redline-item" wx:for="{{chapter3.redlineChecklist.recommended}}" wx:key="index">
        <view class="redline-dot redline-dot-gray"></view>
        <view class="redline-content">
          <text class="redline-title">{{item.text}}</text>
        </view>
      </view>
    </view>

    <!-- M3-3 安全底线（条件显示） -->
    <view wx:if="{{chapter3.safetyBudgetWarning}}" class="upgrade-block safety-block">
      <text class="upgrade-item">{{chapter3.safetyBudgetWarning}}</text>
    </view>
    <view wx:if="{{chapter3.safetyItems.length > 0}}" class="redline-list safety-list">
      <view class="redline-item" wx:for="{{chapter3.safetyItems}}" wx:key="index">
        <view class="redline-dot safety-dot"></view>
        <view class="redline-content">
          <text class="redline-title">{{item}}</text>
        </view>
      </view>
    </view>

    <!-- M3-4 配置兼容性说明 -->
    <view class="compat-block">
      <view wx:if="{{chapter3.conflictAlert.hasNoConflict}}">
        <text class="compat-ok">✓ {{chapter3.conflictAlert.noConflictText}}</text>
      </view>
      <view wx:if="{{!chapter3.conflictAlert.hasNoConflict}}">
        <text class="compat-warn-title">{{chapter3.conflictAlert.title}}</text>
        <view wx:for="{{chapter3.conflictAlert.items}}" wx:key="index">
          <text class="upgrade-item">· {{item}}</text>
        </view>
        <text wx:if="{{chapter3.conflictAlert.cost_estimate}}" class="upgrade-rec">{{chapter3.conflictAlert.cost_estimate}}</text>
      </view>
    </view>

    <!-- ===== 第四章 ===== -->
    <view class="chapter-header">
      <text class="chapter-num">第四章</text>
      <text class="chapter-title">{{chapter4.title}}</text>
    </view>

    <!-- M4-1 三阶段过程框架 -->
    <view class="three-phase-wrap">
      <view class="three-phase-card" wx:for="{{chapter4.threePhaseIntro.phases}}" wx:key="phase">
        <view class="phase-header">
          <view class="phase-num-badge">
            <text class="phase-num-text">{{item.phase}}</text>
          </view>
          <view class="phase-header-body">
            <text class="phase-title">{{item.title}}</text>
            <text class="phase-timing">{{item.timing}}</text>
          </view>
        </view>
        <text class="phase-action">{{item.action}}</text>
        <text wx:if="{{item.hint}}" class="phase-hint">{{item.hint}}</text>
        <view wx:if="{{item.nextTrigger}}" class="phase-trigger-wrap">
          <text class="phase-trigger">→ {{item.nextTrigger}}</text>
        </view>
      </view>
    </view>

    <!-- M4-2 场景化风险提示 -->
    <view wx:if="{{chapter4.isRisk}}" class="risks-section">
      <text class="section-sub-title">本案风险提示</text>
      <view class="risk-card" wx:for="{{chapter4.risks.items}}" wx:key="title">
        <text class="risk-title">{{item.title}}</text>
        <text class="risk-desc">{{item.desc}}</text>
        <view class="risk-question-wrap">
          <text class="risk-q-label">面对商家时问：</text>
          <text class="risk-question">{{item.question}}</text>
        </view>
      </view>
    </view>

    <!-- M4-3 商家答题表（四段完整结构） -->
    <text class="section-sub-title">商家答题表</text>
    <text class="position-statement">{{chapter4.merchantQuestionnaire.subtitle}}</text>

    <!-- 第一段：商家基本信息 -->
    <view class="qa-section">
      <text class="qa-section-title">基本信息</text>
      <view class="qa-section-body">
        <view class="qa-field-item"
              wx:for="{{chapter4.merchantQuestionnaire.section1.fields}}"
              wx:key="label">
          <text class="qa-field-label">{{item.label}}</text>
          <view wx:if="{{item.type === 'checkbox'}}" class="qa-options">
            <text class="qa-opt"
                  wx:for="{{item.options}}" wx:key="*this" wx:for-item="opt">{{opt}}</text>
          </view>
          <view wx:else class="qa-input-mock">
            <text class="qa-placeholder">{{item.placeholder}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 第二段：技术答题表（列名列表，方案A） -->
    <view class="qa-section">
      <text class="qa-section-title">技术答题表</text>
      <text class="qa-hint">{{chapter4.merchantQuestionnaire.section2.hint}}</text>
      <view class="qa-section-body">
        <view class="qa-column-item"
              wx:for="{{chapter4.merchantQuestionnaire.section2.columns}}"
              wx:key="*this">
          <text class="qa-column-dot">·</text>
          <text class="qa-column-name">{{item}}</text>
        </view>
      </view>
      <text class="qa-note">{{chapter4.merchantQuestionnaire.section2.note}}</text>
    </view>

    <!-- 第三段：红线承诺 -->
    <view class="qa-section">
      <text class="qa-section-title">红线承诺</text>
      <text class="qa-hint">{{chapter4.merchantQuestionnaire.section_redline.intro}}</text>
      <view class="redline-confirm-list">
        <view class="redline-confirm-item"
              wx:for="{{chapter4.merchantQuestionnaire.section_redline.items}}"
              wx:key="displayId">
          <text class="redline-confirm-id">{{item.displayId}}</text>
          <text class="redline-confirm-text">{{item.text}}</text>
        </view>
      </view>
      <view class="qa-clause-wrap">
        <text class="qa-clause-text">{{chapter4.merchantQuestionnaire.section_redline.clauseNote}}</text>
      </view>
    </view>

    <!-- 第四段：施工态度问答 -->
    <view class="qa-section">
      <text class="qa-section-title">施工态度</text>
      <view class="qa-section-body">
        <view class="qa-item"
              wx:for="{{chapter4.merchantQuestionnaire.section3.questions}}"
              wx:key="*this">
          <text class="qa-label">{{item}}</text>
        </view>
      </view>
    </view>

    <!-- M4-4 进场核查拍摄清单 -->
    <view wx:if="{{chapter4.inspectionChecklist}}">
      <text class="section-sub-title">进场核查清单</text>
      <text class="chapter-intro">{{chapter4.inspectionChecklist.intro}}</text>

      <!-- 必须拍 -->
      <view class="ic-section">
        <text class="ic-section-label">必须拍</text>
        <view class="ic-list">
          <view class="ic-item" wx:for="{{chapter4.inspectionChecklist.mustShoot}}" wx:key="id">
            <view class="ic-item-header">
              <text class="ic-id">{{item.id}}</text>
              <text class="ic-subject">{{item.subject}}</text>
            </view>
            <text class="ic-purpose">{{item.purpose}}</text>
            <text wx:if="{{item.warning}}" class="ic-warning">⚠ {{item.warning}}</text>
          </view>
        </view>
      </view>

      <!-- 尽量拍 -->
      <view class="ic-section">
        <text class="ic-section-label">建议拍</text>
        <view class="ic-list">
          <view class="ic-item" wx:for="{{chapter4.inspectionChecklist.shouldShoot}}" wx:key="id">
            <view class="ic-item-header">
              <text class="ic-id">{{item.id}}</text>
              <text class="ic-subject">{{item.subject}}</text>
            </view>
            <text class="ic-purpose">{{item.purpose}}</text>
            <text wx:if="{{item.caveat}}" class="ic-caveat">{{item.caveat}}</text>
          </view>
        </view>
      </view>

      <!-- 靠文件 -->
      <view class="ic-section">
        <text class="ic-section-label">靠文件核查</text>
        <view class="ic-list">
          <view class="ic-item" wx:for="{{chapter4.inspectionChecklist.useDocument}}" wx:key="id">
            <view class="ic-item-header">
              <text class="ic-id">{{item.id}}</text>
              <text class="ic-subject">{{item.checkItem}}</text>
            </view>
            <text class="ic-alt">核查方式：{{item.alternative}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- M4-5 验收节点 -->
    <text class="section-sub-title">验收节点</text>
    <view class="inspection-section"
          wx:for="{{chapter4.acceptance.nodes}}" wx:key="title">
      <text class="inspection-phase">{{item.title}}</text>
      <view class="inspection-item-wrap"
            wx:for="{{item.items}}" wx:key="text" wx:for-item="node">
        <text class="inspection-item">· {{node.text}}</text>
        <text wx:if="{{node.reason}}" class="inspection-reason">→ {{node.reason}}</text>
      </view>
    </view>

    <!-- M4-5 专业审计入口 -->
    <view class="l2-entry" bindtap="onL2Entry">
      <text class="l2-entry-text">商家填回来的内容，需要专业核查？</text>
      <text class="l2-entry-action">进入招标管理 →</text>
    </view>

    <view class="footer-note">本文件由门窗诊断系统生成 · 仅供采购参考</view>

  </view>

</scroll-view>