<scroll-view scroll-y class="page">

  <!-- L1 摘要卡：始终可见 -->
  <view class="cover-card">
    <text class="cover-sub">门窗需求定制招标文件</text>
    <text class="cover-title">{{cover.city}}</text>
    <text class="cover-sub">{{cover.floorDesc}}</text>
    <text class="cover-date">生成于 {{cover.issueDate}}</text>
  </view>

  <view class="section-label">关键参数指标</view>
  <view class="param-grid">
    <view class="param-card">
      <text class="param-label">保温</text>
      <text class="param-value">{{computed.K_target}}</text>
      <text class="param-unit">W/(m²·K) · K值</text>
    </view>
    <view class="param-card">
      <text class="param-label">隔音</text>
      <text class="param-value">{{computed.Rw_required}}</text>
      <text class="param-unit">dB · Rw值</text>
    </view>
    <view class="param-card">
      <text class="param-label">遮阳</text>
      <text class="param-value">{{computed.SHGC_target || '—'}}</text>
      <text class="param-unit">SHGC</text>
    </view>
    <view class="param-card">
      <text class="param-label">抗风压</text>
      <text class="param-value">{{computed.P3_required}}级</text>
      <text class="param-unit">{{computed.wind_zone}}</text>
    </view>
    <view class="param-card">
      <text class="param-label">密封性能</text>
      <text class="param-value">气密{{computed.airRec}}级</text>
      <text class="param-unit">水密{{computed.waterRec}}级</text>
    </view>
    <view class="param-card">
      <text class="param-label">安全</text>
      <text class="param-value" style="font-size:14px;">需专项核查</text>
      <text class="param-unit">查看完整报告</text>
    </view>
  </view>

  <!-- 付费按钮：未解锁时可见 -->
  <view wx:if="{{!isPaid}}" class="unlock-btn" bindtap="onUnlock">
    <text class="unlock-btn-text">¥99 限时免费，直接发给商家比价</text>
    <text class="unlock-btn-sub">含完整技术参数与验收标准，商家看到就知道你懂行</text>
  </view>

  <!-- 四章内容：付费后可见 -->
  <view wx:if="{{isPaid}}">

    <!-- 第1章 -->
    <view class="chapter-header">
      <text class="chapter-num">第一章</text>
      <text class="chapter-title">性能需求诊断</text>
    </view>

    <view class="param-grid">
      <view class="param-card {{item.isCore ? 'param-card-core' : ''}}"
            wx:for="{{chapter1.needsAnalysis.needsTable}}" wx:key="dimension">
        <text class="param-label">{{item.dimension}}</text>
        <text class="param-value">{{item.value}}</text>
        <text class="param-unit">{{item.basis}}</text>
      </view>
    </view>

    <view wx:if="{{chapter1.redLines.safetyBudgetWarning}}" class="upgrade-block">
      <text class="upgrade-title">{{chapter1.redLines.safetyBudgetWarning.title}}</text>
      <view wx:for="{{chapter1.redLines.safetyBudgetWarning.items}}" wx:key="index">
        <text class="upgrade-item">· {{item}}</text>
      </view>
    </view>

    <view class="redline-list">
      <view class="redline-item" wx:for="{{chapter1.redLines.forbidden}}" wx:key="index">
        <view class="redline-dot"></view>
        <view class="redline-content">
          <text class="redline-title">{{item.title}}</text>
          <text class="redline-desc">{{item.desc}}</text>
        </view>
      </view>
      <view class="redline-item" wx:for="{{chapter1.redLines.safetyItems}}" wx:key="index">
        <view class="redline-dot"></view>
        <view class="redline-content">
          <text class="redline-title">{{item.title}}</text>
          <text class="redline-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>

    <!-- 第2章 -->
    <view class="chapter-header">
      <text class="chapter-num">第二章</text>
      <text class="chapter-title">采购技术底线</text>
    </view>

    <text class="position-statement">{{chapter2.positionStatement}}</text>

    <view class="table-wrap">
      <view class="table-head">
        <text class="col-a">配置项</text>
        <text class="col-b">最低规格</text>
        <text class="col-c">验证方式</text>
      </view>
      <view class="table-row {{index % 2 === 1 ? 'alt' : ''}}"
            wx:for="{{chapter2.metrics}}" wx:key="name">
        <text class="col-a th">{{item.name}}</text>
        <text class="col-b">{{item.value}}</text>
        <text class="col-c">{{item.std}}</text>
      </view>
    </view>

    <!-- 第3章 -->
    <view class="chapter-header">
      <text class="chapter-num">第三章</text>
      <text class="chapter-title">红线清单</text>
    </view>

    <view wx:if="{{chapter3.conflictAlert}}" class="upgrade-block">
      <text class="upgrade-title">{{chapter3.conflictAlert.title}}</text>
      <view wx:for="{{chapter3.conflictAlert.items}}" wx:key="index">
        <text class="upgrade-item">· {{item}}</text>
      </view>
      <view class="upgrade-divider"></view>
      <text class="upgrade-rec">{{chapter3.conflictAlert.cost_estimate}}</text>
    </view>

    <view class="two-col" wx:if="{{chapter3.is_dual_tier}}">
      <view class="col-card" wx:for="{{chapter3.dualTierSpecs}}" wx:key="label">
        <text class="col-label">{{item.label}}</text>
        <text class="col-item">{{item.glass}}</text>
        <text class="col-item">{{item.profile}}</text>
        <text class="col-item">{{item.hardware}}</text>
      </view>
    </view>

    <view class="redline-list">
      <view class="redline-item" wx:for="{{chapter3.redlineChecklist.mandatory}}" wx:key="index">
        <view class="redline-dot"></view>
        <view class="redline-content">
          <text class="redline-title">{{item.text}}</text>
        </view>
      </view>
      <view class="redline-item" wx:for="{{chapter3.redlineChecklist.recommended}}" wx:key="index">
        <view class="redline-dot redline-dot-gray"></view>
        <view class="redline-content">
          <text class="redline-title">{{item.text}}</text>
        </view>
      </view>
    </view>

    <!-- 第4章 -->
    <view class="chapter-header">
      <text class="chapter-num">第四章</text>
      <text class="chapter-title">商家答题表 · 验收节点</text>
    </view>

    <view class="qa-form">
      <view class="qa-item"
            wx:for="{{chapter4.merchantQuestionnaire.section3.questions}}" wx:key="*this">
        <text class="qa-label">{{item}}</text>
      </view>
    </view>

    <view class="inspection-section"
          wx:for="{{chapter4.acceptance.nodes}}" wx:key="phase">
      <text class="inspection-phase">{{item.title}}</text>
      <view wx:for="{{item.items}}" wx:key="*this" wx:for-item="node">
        <text class="inspection-item">· {{node}}</text>
      </view>
    </view>

    <view class="footer-note">本文件由门窗诊断系统生成 · 仅供采购参考</view>

  </view>

</scroll-view>
