<scroll-view scroll-y class="page">

  <!-- L1 摘要卡：始终可见 -->
  <view class="cover-card">
    <text class="cover-sub">门窗需求定制招标文件</text>
    <text class="cover-title">{{cover.city}}</text>
    <text class="cover-sub">{{cover.floorDesc}}</text>
    <text class="cover-date">生成于 {{cover.issueDate}}</text>
  </view>

  <view class="section-label">关键参数指标</view>
  <!-- 参数格第一行：保温/隔音/遮阳/抗风压 -->
  <view class="param-grid">
    <view class="param-card param-card-blue">
      <view class="param-card-header">
        <text class="param-label param-label-blue">保温</text>
        <image class="param-icon" src="/images/icon-thermal.svg" mode="aspectFit"/>
      </view>
      <view class="param-value-row">
        <text class="param-op param-op-blue">≤</text>
        <text class="param-value">{{summary.k_target}}</text>
      </view>
      <text class="param-unit param-unit-blue">W/(m²·K) · K值</text>
    </view>
    <view class="param-card param-card-purple">
      <view class="param-card-header">
        <text class="param-label param-label-purple">隔音</text>
        <image class="param-icon" src="/images/icon-acoustic.svg" mode="aspectFit"/>
      </view>
      <view class="param-value-row">
        <text class="param-op param-op-purple">≥</text>
        <text class="param-value">{{summary.rw_required}}</text>
      </view>
      <text class="param-unit param-unit-purple">dB · Rw值</text>
    </view>
    <view class="param-card param-card-amber">
      <view class="param-card-header">
        <text class="param-label param-label-amber">遮阳</text>
        <image class="param-icon" src="/images/icon-solar.svg" mode="aspectFit"/>
      </view>
      <view class="param-value-row">
        <text class="param-op param-op-amber">≤</text>
        <text class="param-value">{{summary.shgc_target || '—'}}</text>
      </view>
      <text class="param-unit param-unit-amber">SHGC</text>
    </view>
    <view class="param-card param-card-teal">
      <view class="param-card-header">
        <text class="param-label param-label-teal">抗风压</text>
        <image class="param-icon" src="/images/icon-wind.svg" mode="aspectFit"/>
      </view>
      <view class="param-value-row">
        <text class="param-op param-op-teal">≥</text>
        <text class="param-value param-value-md">{{summary.p3_required}}<text class="param-value-unit-inline">kPa</text></text>
      </view>
      <text class="param-unit param-unit-teal">{{summary.wind_zone}} 等级</text>
    </view>
  </view>
  <!-- 参数格第二行：密封性能/安全 -->
  <view class="param-grid">
    <view class="param-card param-card-gray">
      <view class="param-card-header">
        <text class="param-label param-label-gray">密封性能</text>
        <image class="param-icon" src="/images/icon-seal.svg" mode="aspectFit"/>
      </view>
      <view class="seal-values">
        <view class="seal-col">
          <text class="seal-grade">{{summary.air_rec}}级</text>
          <text class="seal-type">气密</text>
        </view>
        <view class="seal-divider"></view>
        <view class="seal-col">
          <text class="seal-grade">{{summary.water_rec}}级</text>
          <text class="seal-type">水密</text>
        </view>
      </view>
      <text class="param-unit param-unit-gray">综合反映安装工艺质量</text>
    </view>
    <view class="param-card param-card-warn">
      <view class="param-card-header">
        <text class="param-label param-label-warn">安全</text>
        <image class="param-icon" src="/images/icon-safety.svg" mode="aspectFit"/>
      </view>
      <view class="warn-value-row">
        <view class="warn-dot"></view>
        <text class="warn-value-text">需专项核查</text>
      </view>
      <text class="param-unit param-unit-warn">查看完整报告</text>
    </view>
  </view>
  <!-- 解锁按钮：未解锁时可见 -->
  <view wx:if="{{!isPaid}}" class="unlock-btn" bindtap="onUnlock">
    <view class="unlock-btn-inner">
      <view class="unlock-icon-wrap">
        <image class="unlock-icon" src="/images/icon-unlock.svg" mode="aspectFit"/>
      </view>
      <view class="unlock-text-col">
        <text class="unlock-btn-text">免费解锁完整招标文件</text>
        <view class="unlock-free-badge">
          <text class="unlock-free-text">限时免费开放</text>
        </view>
      </view>
      <view class="unlock-arrow">
        <image class="unlock-arrow-icon" src="/images/icon-arrow-right.svg" mode="aspectFit"/>
      </view>
    </view>
    <view class="unlock-divider"></view>
    <view class="unlock-items-row">
      <text class="unlock-item-label">技术底线</text>
      <view class="unlock-item-dot"></view>
      <text class="unlock-item-label">红线清单</text>
      <view class="unlock-item-dot"></view>
      <text class="unlock-item-label">三阶段验收</text>
    </view>
  </view>

  <!-- L2 完整版：付费后渲染 -->
  <view wx:if="{{isPaid}}" class="chapters-wrap">

    <!-- ===== 开篇 · 你的需求画像 ===== -->
    <view class="chapter-header overview-header">
      <text class="chapter-title">你的需求画像</text>
    </view>
    <view class="overview-block">
      <!-- 数据来源声明 -->
      <view class="datasource-note" wx:if="{{overview.dataSourceStatement}}">
        <text class="datasource-text">{{overview.dataSourceStatement}}</text>
      </view>
      <!-- 核心诉求 -->
      <view class="tension-block" wx:if="{{overview.coreTension}}">
        <text class="tension-text">{{overview.coreTension}}</text>
      </view>
    </view>

    <!-- ===== 第一章 · 隔声 ===== -->
    <view class="chapter-header">
      <text class="chapter-num">第一章</text>
      <text class="chapter-title">隔声</text>
    </view>
    <view class="chapter1-block">
      <!-- 1.1 隔声目标 -->
      <view class="target-section" wx:if="{{chapter1.targetValue}}">
        <text class="section-sub-title">你的隔声目标</text>
        <view class="target-card">
          <text class="target-value">Rw ≥ {{chapter1.targetValue.Rw}} {{chapter1.targetValue.unit}}</text>
        </view>
      </view>
      <!-- 1.2 影响因素 -->
      <view class="factors-section" wx:if="{{chapter1.factors}}">
        <text class="section-sub-title">影响因素</text>
        <view class="factor-list">
          <view class="factor-item" wx:for="{{chapter1.factors}}" wx:key="name">
            <text class="factor-name">{{item.name}}</text>
            <text class="factor-desc">{{item.description}}</text>
          </view>
        </view>
      </view>
      <!-- 1.3 隔声红线 -->
      <view class="redlines-section" wx:if="{{chapter1.redlines.length > 0}}">
        <text class="section-sub-title">隔声红线</text>
        <view class="redline-list">
          <view class="redline-item" wx:for="{{chapter1.redlines}}" wx:key="id">
            <text class="item-id">{{item.displayId || item.id}}</text>
            <text class="redline-title">{{item.text}}</text>
          </view>
        </view>
      </view>
      <!-- 噪声场景（条件显示） -->
      <view wx:if="{{chapter1.noise.show}}" class="noise-context">
        <text class="noise-type">{{chapter1.noise.typeLabel}}</text>
        <text class="noise-dist">{{chapter1.noise.distLabel}}</text>
      </view>
    </view>

    <!-- ===== 第二章 · 热工 ===== -->
    <view class="chapter-header">
      <text class="chapter-num">第二章</text>
      <text class="chapter-title">热工</text>
    </view>
    <view class="chapter2-block">
      <!-- 2.1 热工目标 -->
      <view class="target-section" wx:if="{{chapter2.targetValue}}">
        <text class="section-sub-title">你的热工目标</text>
        <view class="target-card">
          <text class="target-value">K ≤ {{chapter2.targetValue.K}} {{chapter2.targetValue.unit_K}}</text>
          <text class="target-value" wx:if="{{chapter2.targetValue.SHGC}}">SHGC ≤ {{chapter2.targetValue.SHGC}}</text>
        </view>
      </view>
      <!-- 2.2 影响因素 -->
      <view class="factors-section" wx:if="{{chapter2.factors}}">
        <text class="section-sub-title">影响因素</text>
        <view class="factor-list">
          <view class="factor-item" wx:for="{{chapter2.factors}}" wx:key="name">
            <text class="factor-name">{{item.name}}</text>
            <text class="factor-desc">{{item.description}}</text>
          </view>
        </view>
      </view>
      <!-- 2.3 热工红线 -->
      <view class="redlines-section" wx:if="{{chapter2.redlines.length > 0}}">
        <text class="section-sub-title">热工红线</text>
        <view class="redline-list">
          <view class="redline-item" wx:for="{{chapter2.redlines}}" wx:key="id">
            <text class="item-id">{{item.displayId || item.id}}</text>
            <text class="redline-title">{{item.text}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- ===== 第三章 · 抗风 ===== -->
    <view class="chapter-header">
      <text class="chapter-num">第三章</text>
      <text class="chapter-title">抗风</text>
    </view>
    <view class="chapter3-block">
      <!-- 3.1 抗风目标 -->
      <view class="target-section" wx:if="{{chapter3.targetValue}}">
        <text class="section-sub-title">你的抗风目标</text>
        <view class="target-card">
          <text class="target-value">P3 ≥ {{chapter3.targetValue.P3}} {{chapter3.targetValue.unit}}</text>
        </view>
      </view>
      <!-- 3.2 影响因素 -->
      <view class="factors-section" wx:if="{{chapter3.factors}}">
        <text class="section-sub-title">影响因素</text>
        <view class="factor-list">
          <view class="factor-item" wx:for="{{chapter3.factors}}" wx:key="name">
            <text class="factor-name">{{item.name}}</text>
            <text class="factor-desc">{{item.description}}</text>
          </view>
        </view>
      </view>
      <!-- 3.3 抗风红线 -->
      <view class="redlines-section" wx:if="{{chapter3.redlines.length > 0}}">
        <text class="section-sub-title">抗风红线</text>
        <view class="redline-list">
          <view class="redline-item" wx:for="{{chapter3.redlines}}" wx:key="id">
            <text class="item-id">{{item.displayId || item.id}}</text>
            <text class="redline-title">{{item.text}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- ===== 第四章 · 水密气密 ===== -->
    <view class="chapter-header">
      <text class="chapter-num">第四章</text>
      <text class="chapter-title">水密气密</text>
    </view>
    <view class="chapter4-block">
      <!-- 4.1 水密气密目标 -->
      <view class="target-section" wx:if="{{chapter4.targetValue}}">
        <text class="section-sub-title">你的水密气密目标</text>
        <view class="target-card">
          <text class="target-value">水密 ≥ {{chapter4.targetValue.water}} {{chapter4.targetValue.unit}}</text>
          <text class="target-value">气密 ≥ {{chapter4.targetValue.air}} {{chapter4.targetValue.unit}}</text>
        </view>
      </view>
      <!-- 4.2 影响因素 -->
      <view class="factors-section" wx:if="{{chapter4.factors}}">
        <text class="section-sub-title">影响因素</text>
        <view class="factor-list">
          <view class="factor-item" wx:for="{{chapter4.factors}}" wx:key="name">
            <text class="factor-name">{{item.name}}</text>
            <text class="factor-desc">{{item.description}}</text>
          </view>
        </view>
      </view>
      <!-- 4.3 水密气密红线 -->
      <view class="redlines-section" wx:if="{{chapter4.redlines.length > 0}}">
        <text class="section-sub-title">水密气密红线</text>
        <view class="redline-list">
          <view class="redline-item" wx:for="{{chapter4.redlines}}" wx:key="id">
            <text class="item-id">{{item.displayId || item.id}}</text>
            <text class="redline-title">{{item.text}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- ===== 第五章 · 安全配置（条件显示） ===== -->
    <view wx:if="{{chapter5.show}}" class="chapter-header">
      <text class="chapter-num">第五章</text>
      <text class="chapter-title">安全配置</text>
    </view>
    <view wx:if="{{chapter5.show}}" class="chapter5-block">
      <!-- 5.1 安全场景说明 -->
      <view class="safety-context" wx:if="{{chapter5.triggers}}">
        <text class="section-sub-title">为什么需要安全配置</text>
        <view class="trigger-list">
          <text wx:if="{{chapter5.triggers.has_large_fixed}}" class="trigger-item">· 存在大面积固定窗/落地窗</text>
          <text wx:if="{{chapter5.triggers.has_children}}" class="trigger-item">· 家中有儿童</text>
          <text wx:if="{{chapter5.triggers.window_type === 'sliding'}}" class="trigger-item">· 推拉窗安全要求</text>
        </view>
      </view>
      <!-- 5.2 安全要求 -->
      <view class="requirements-section" wx:if="{{chapter5.requirements.length > 0}}">
        <text class="section-sub-title">安全要求</text>
        <view class="requirement-list">
          <view class="requirement-item" wx:for="{{chapter5.requirements}}" wx:key="item">
            <text class="req-item">{{item.item}}: {{item.spec}}</text>
          </view>
        </view>
      </view>
      <!-- 5.3 安全红线 -->
      <view class="redlines-section" wx:if="{{chapter5.redlines.length > 0}}">
        <text class="section-sub-title">安全红线</text>
        <view class="redline-list">
          <view class="redline-item" wx:for="{{chapter5.redlines}}" wx:key="id">
            <text class="item-id">{{item.displayId || item.id}}</text>
            <text class="redline-title">{{item.text}}</text>
          </view>
        </view>
      </view>
      <!-- 5.4 可选优化项 -->
      <view class="optional-section" wx:if="{{chapter5.optionalUpgrades.length > 0}}">
        <text class="section-sub-title">可选优化</text>
        <view class="upgrade-list">
          <text class="upgrade-item" wx:for="{{chapter5.optionalUpgrades}}" wx:key="*this">· {{item}}</text>
        </view>
      </view>
    </view>

    <!-- ===== 过渡小节 ===== -->
    <view class="transition-block" wx:if="{{transition}}">
      <view class="transition-header">
        <text class="transition-title">{{transition.title}}</text>
      </view>
      <view class="transition-body">
        <text class="transition-guide">{{transition.guideText}}</text>
      </view>
    </view>

    <!-- ===== 第六章 · 配置汇总答题表 ===== -->
    <view class="chapter-header">
      <text class="chapter-num">第六章</text>
      <text class="chapter-title">配置汇总答题表</text>
    </view>
    <view class="chapter6-block">
      <text class="section-sub-title" wx:if="{{chapter6.intro}}">{{chapter6.intro}}</text>
      <!-- 配置汇总表 -->
      <view class="config-table" wx:if="{{chapter6.configSummaryTable}}">
        <view class="config-table-header">
          <text class="col-field">项目</text>
          <text class="col-spec">本案要求</text>
          <text class="col-proof">证明要求</text>
        </view>
        <view class="config-table-row {{item.category}}" wx:for="{{chapter6.configSummaryTable}}" wx:key="id">
          <view class="col-field">
            <text class="field-id">{{item.id}}</text>
            <text class="field-label">{{item.label}}</text>
          </view>
          <text class="col-spec">{{chapter6.specValues[item.id] || '待填写'}}</text>
          <text class="col-proof">{{item.proof_required || '-'}}</text>
        </view>
      </view>
      <!-- 红线承诺确认 -->
      <view class="redline-confirm-section" wx:if="{{chapter6.redlineConfirm}}">
        <text class="section-sub-title">{{chapter6.redlineConfirm.title}}</text>
        <text class="redline-confirm-text">{{chapter6.redlineConfirm.text}}</text>
        <view class="redline-confirm-list">
          <view class="redline-confirm-item" wx:for="{{chapter6.redlineConfirm.checklist}}" wx:key="id">
            <text class="confirm-checkbox">☐</text>
            <text class="confirm-text">{{item.displayId}} {{item.text}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- ===== 第七章 · 三阶段过程把控 ===== -->
    <view class="chapter-header">
      <text class="chapter-num">第七章</text>
      <text class="chapter-title">三阶段过程把控</text>
    </view>
    <view class="chapter7-block">
      <view class="phase-card" wx:for="{{chapter7.phases}}" wx:key="name">
        <view class="phase-header-row">
          <text class="phase-name">{{item.name}}</text>
        </view>
        <text class="phase-checklist">{{item.checklist}}</text>
        <!-- 关键项目 -->
        <view class="phase-key-items" wx:if="{{item.keyItems}}">
          <text class="key-items-label">重点关注：</text>
          <text class="key-item" wx:for="{{item.keyItems}}" wx:key="*this">{{item}}</text>
        </view>
        <!-- 进场核查清单 -->
        <view class="phase-inspection" wx:if="{{item.inspectionItems.length > 0}}">
          <text class="inspection-label">进场核查项：</text>
          <view class="inspection-item" wx:for="{{item.inspectionItems}}" wx:key="id">
            <text class="inspection-id">{{item.id}}</text>
            <text class="inspection-subject">{{item.subject}}</text>
          </view>
        </view>
        <!-- 验收节点 -->
        <view class="phase-acceptance" wx:if="{{item.acceptanceItems}}">
          <text class="acceptance-label">验收标准：</text>
          <text class="acceptance-item" wx:for="{{item.acceptanceItems}}" wx:key="*this">· {{item}}</text>
        </view>
      </view>
    </view>

    <!-- 专业审计入口 -->
    <view class="l2-entry" bindtap="onL2Entry">
      <text class="l2-entry-text">商家填回来的内容，需要专业核查？</text>
      <text class="l2-entry-action">进入招标管理 →</text>
    </view>

    <view class="footer-note">本文件由门窗诊断系统生成 · 仅供采购参考</view>

  </view>

</scroll-view>
