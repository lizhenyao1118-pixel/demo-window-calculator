page { background: #f5f5f0; }

.page { padding: 12px 16px 40px; width: 100%; box-sizing: border-box; overflow: hidden; }

.section-label {
  font-size: 11px;
  color: #999;
  letter-spacing: 0.5px;
  margin: 16px 0 8px;
}

/* TYPE 1 封面 */
.cover-card {
  background: #fff;
  border-radius: 12px;
  border: 0.5px solid rgba(0,0,0,0.08);
  padding: 20px 16px;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.cover-sub { font-size: 11px; color: #999; margin-bottom: 4px; }
.cover-title { font-size: 20px; font-weight: 500; color: #1a1a1a; margin-bottom: 4px; }
.cover-date { font-size: 12px; color: #888; }
.chapter-tabs {
  display: flex;
  flex-direction: row;
  gap: 6px;
  margin-top: 16px;
}
.tab-active {
  background: #e8f0fe;
  color: #3b6bc9;
  font-size: 11px;
  padding: 4px 12px;
  border-radius: 4px;
}
.tab {
  background: #f0f0ec;
  color: #888;
  font-size: 11px;
  padding: 4px 12px;
  border-radius: 4px;
}

/* TYPE 2 参数卡片 */
.param-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 8px;
}
.param-card {
  width: calc(50% - 4px);
  background: #f0f0ec;
  border-radius: 8px;
  padding: 12px;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}
.param-label { font-size: 11px; color: #666; margin-bottom: 4px; }
.param-symbol {
  font-size: 16px;
  color: #999;
  text-align: center;
}
.param-value { font-size: 28px; font-weight: 500; color: #1a1a1a; line-height: 1.1; }
.param-unit { font-size: 11px; color: #999; margin-top: 2px; }

/* TYPE 3 升级提示 */
.upgrade-block {
  background: #fffbf0;
  border: 0.5px solid #f0c060;
  border-radius: 10px;
  padding: 14px;
  display: flex;
  flex-direction: column;
}
.upgrade-title { font-size: 13px; font-weight: 500; color: #a06000; margin-bottom: 8px; }
.upgrade-item { font-size: 12px; color: #a06000; line-height: 1.8; }
.upgrade-divider {
  height: 0.5px;
  background: #f0c060;
  margin: 10px 0;
}
.upgrade-rec { font-size: 12px; color: #a06000; line-height: 1.8; }

/* TYPE 4 双栏 */
.two-col {
  display: flex;
  flex-direction: row;
  gap: 8px;
}
.col-card {
  flex: 1;
  background: #fff;
  border: 0.5px solid rgba(0,0,0,0.08);
  border-radius: 8px;
  padding: 12px;
  display: flex;
  flex-direction: column;
}
.col-label { font-size: 11px; color: #888; margin-bottom: 6px; }
.col-item { font-size: 12px; color: #1a1a1a; line-height: 1.8; }

/* TYPE 5 表格 */
.table-wrap {
  background: #fff;
  border: 0.5px solid rgba(0,0,0,0.08);
  border-radius: 8px;
  overflow: hidden;
}
.table-head, .table-row {
  display: flex;
  flex-direction: row;
  padding: 8px 12px;
}
.table-head { background: #f0f0ec; }
.table-row { border-top: 0.5px solid rgba(0,0,0,0.06); }
.table-row.alt { background: #fafaf8; }
.col-a { width: 64px; font-size: 11px; color: #888; flex-shrink: 0; }
.col-a.th { font-size: 12px; color: #888; }
.col-b { flex: 1; font-size: 12px; color: #1a1a1a; padding-right: 8px; }
.col-c { width: 56px; font-size: 11px; color: #888; text-align: right; flex-shrink: 0; }
.table-head .col-b, .table-head .col-c { font-size: 11px; color: #888; }

/* TYPE 6 红线清单 */
.redline-list {
  background: #fff;
  border: 0.5px solid rgba(0,0,0,0.08);
  border-radius: 8px;
}
.redline-item {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  padding: 12px 14px;
  border-bottom: 0.5px solid rgba(0,0,0,0.06);
}
.redline-item.no-border { border-bottom: none; }
.redline-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #e05252;
  margin-top: 4px;
  flex-shrink: 0;
  margin-right: 10px;
}
.redline-content { display: flex; flex-direction: column; flex: 1; }
.redline-title { font-size: 13px; font-weight: 500; color: #1a1a1a; margin-bottom: 3px; }
.redline-desc { font-size: 11px; color: #888; line-height: 1.5; }

/* TYPE 7 答题表 */
.qa-form {
  background: #fff;
  border: 0.5px solid rgba(0,0,0,0.08);
  border-radius: 8px;
  padding: 14px;
}
.qa-item { margin-bottom: 14px; }
.qa-item:last-child { margin-bottom: 0; }
.qa-label { font-size: 11px; color: #888; margin-bottom: 6px; display: block; }
.qa-input-mock {
  background: #f5f5f0;
  border-radius: 6px;
  padding: 9px 12px;
}
.qa-placeholder { font-size: 13px; color: #bbb; }
.qa-options { display: flex; flex-direction: row; gap: 8px; margin-top: 4px; }
.qa-opt-active {
  background: #e8f0fe;
  color: #3b6bc9;
  font-size: 12px;
  padding: 6px 16px;
  border-radius: 6px;
}
.qa-opt {
  background: #f0f0ec;
  color: #888;
  font-size: 12px;
  padding: 6px 16px;
  border-radius: 6px;
}

.footer-note {
  text-align: center;
  font-size: 11px;
  color: #ccc;
  margin-top: 24px;
}

/* 付费解锁按钮 */
.unlock-btn {
  background: #07c160;
  border-radius: 10px;
  padding: 16px;
  margin: 20px 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.unlock-btn-text {
  font-size: 16px;
  font-weight: 600;
  color: #fff;
  margin-bottom: 4px;
}
.unlock-btn-sub {
  font-size: 11px;
  color: rgba(255,255,255,0.85);
}

/* 章节标题 */
.chapter-header {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 8px;
  margin: 24px 0 12px;
  padding-bottom: 8px;
  border-bottom: 0.5px solid rgba(0,0,0,0.08);
}
.chapter-num {
  font-size: 11px;
  color: #3b6bc9;
  background: #e8f0fe;
  padding: 2px 8px;
  border-radius: 4px;
}
.chapter-title { font-size: 16px; font-weight: 500; color: #1a1a1a; }

/* 定位说明 */
.position-statement {
  font-size: 12px;
  color: #888;
  line-height: 1.7;
  margin-bottom: 12px;
  display: block;
}

/* 核心参数卡片 */
.param-card-core {
  border: 0.5px solid #3b6bc9;
}

/* 验收节点 */
.inspection-section { margin-bottom: 16px; }
.inspection-phase {
  font-size: 12px;
  font-weight: 500;
  color: #555;
  margin-bottom: 6px;
  display: block;
}
.inspection-item {
  font-size: 12px;
  color: #888;
  line-height: 1.8;
  display: block;
}

/* 付费墙遮罩结构（方案B升级时只需修改此处样式） */
.chapters-wrap { position: relative; }
.chapters-mask {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(255,255,255,0.85);
  z-index: 10;
}

/* 红线清单推荐项灰色圆点 */
.redline-dot-gray {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #bbb;
  margin-top: 4px;
  flex-shrink: 0;
  margin-right: 10px;
}
/* ===== Phase 3 新增样式 ===== */

/* M1-1 项目身份信息格 */
.info-grid {
  background: #fff;
  border: 0.5px solid rgba(0,0,0,0.08);
  border-radius: 8px;
  overflow: hidden;
  margin-bottom: 12px;
}
.info-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  padding: 10px 14px;
  border-bottom: 0.5px solid rgba(0,0,0,0.05);
}
.info-row:last-child { border-bottom: none; }
.info-key {
  font-size: 11px;
  color: #999;
  width: 72px;
  flex-shrink: 0;
  margin-top: 1px;
}
.info-val { font-size: 13px; color: #1a1a1a; flex: 1; line-height: 1.5; }
.info-tag {
  color: #3b6bc9;
  font-weight: 500;
}

/* M1-2 核心诉求声明 */
.tension-block {
  background: #f5f8ff;
  border-left: 3px solid #3b6bc9;
  border-radius: 0 8px 8px 0;
  padding: 14px 16px;
  margin-bottom: 12px;
}
.tension-text {
  font-size: 13px;
  color: #2a3a5c;
  line-height: 1.8;
}

/* M1-3 性能参数卡片 */
.needs-card {
  background: #fff;
  border: 0.5px solid rgba(0,0,0,0.08);
  border-radius: 10px;
  padding: 14px;
  margin-bottom: 10px;
}
.needs-header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 6px;
}
.needs-dimension { font-size: 13px; font-weight: 500; color: #555; }
.needs-value { font-size: 18px; font-weight: 600; color: #1a1a1a; }
.needs-derivation {
  font-size: 11px;
  color: #999;
  line-height: 1.6;
  margin-bottom: 12px;
}

/* 等级区间刻度条 */
.level-bar-wrap { margin-bottom: 10px; }
.level-bar-track {
  position: relative;
  height: 4px;
  background: #e8e8e4;
  border-radius: 2px;
  margin-bottom: 4px;
}
.level-bar-fill {
  position: absolute;
  left: 0;
  top: 0;
  height: 4px;
  background: #3b6bc9;
  border-radius: 2px;
}
.level-bar-marker {
  position: absolute;
  top: -4px;
  width: 12px;
  height: 12px;
  background: #3b6bc9;
  border-radius: 50%;
  margin-left: -6px;
  border: 2px solid #fff;
  box-shadow: 0 1px 3px rgba(59,107,201,0.4);
}
.level-bar-labels {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
}
.level-label-low,
.level-label-high {
  font-size: 10px;
  color: #bbb;
}
.level-bar-mid-row {
  position: relative;
  height: 16px;
  margin-top: 2px;
}
.level-mid-hint {
  position: absolute;
  font-size: 11px;
  color: #3b6bc9;
  white-space: nowrap;
  transform: translateX(-50%);
}

/* 市场现实 */
.market-reality {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 8px;
  margin-top: 8px;
  padding-top: 10px;
  border-top: 0.5px solid rgba(0,0,0,0.05);
}
.market-tag {
  font-size: 10px;
  font-weight: 500;
  padding: 2px 8px;
  border-radius: 3px;
  flex-shrink: 0;
  margin-top: 2px;
}
.tag-green { background: #e6f4ea; color: #1e7e34; }
.tag-orange { background: #fff3e0; color: #e65100; }
.market-desc { font-size: 11px; color: #888; line-height: 1.6; flex: 1; }

/* M2-3 商家回应识别提示 */
.response-guide {
  background: #fff;
  border: 0.5px solid rgba(0,0,0,0.08);
  border-radius: 8px;
  padding: 12px 14px;
  margin-top: 10px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.response-item {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 10px;
}
.response-icon { font-size: 13px; width: 16px; flex-shrink: 0; margin-top: 1px; }
.response-ok { color: #1e7e34; }
.response-warn { color: #e65100; }
.response-bad { color: #c0392b; }
.response-text { font-size: 12px; color: #555; line-height: 1.7; flex: 1; }

/* M3-1 章节定位说明 */
.chapter-intro {
  font-size: 12px;
  color: #888;
  line-height: 1.7;
  margin-bottom: 12px;
  display: block;
}

/* M3-2 红线用户侧含义 */
.redline-meaning {
  font-size: 11px;
  color: #999;
  line-height: 1.6;
  margin-top: 4px;
}

/* M3-3 安全底线样式 */
.safety-block { border-color: #f5a623; background: #fffbf0; }
.safety-list { margin-top: 6px; }
.safety-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #f5a623;
  margin-top: 4px;
  flex-shrink: 0;
  margin-right: 10px;
}

/* M3-4 配置兼容性说明 */
.compat-block {
  background: #fff;
  border: 0.5px solid rgba(0,0,0,0.08);
  border-radius: 8px;
  padding: 12px 14px;
  margin-top: 10px;
}
.compat-ok { font-size: 12px; color: #1e7e34; line-height: 1.6; }
.compat-warn-title { font-size: 13px; font-weight: 500; color: #a06000; margin-bottom: 6px; display: block; }

/* M4-1 行动主线三步 */
.action-steps {
  background: #fff;
  border: 0.5px solid rgba(59,107,201,0.2);
  border-radius: 10px;
  overflow: hidden;
  margin-bottom: 16px;
}
.action-step {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  padding: 14px 16px;
  border-bottom: 0.5px solid rgba(0,0,0,0.06);
  gap: 14px;
}
.action-step:last-child { border-bottom: none; }
.action-step-num {
  width: 24px;
  height: 24px;
  border-radius: 50%;
  background: #3b6bc9;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.action-num-text { font-size: 13px; font-weight: 600; color: #fff; }
.action-step-body { display: flex; flex-direction: column; flex: 1; }
.action-step-title { font-size: 14px; font-weight: 500; color: #1a1a1a; margin-bottom: 3px; }
.action-step-desc { font-size: 12px; color: #555; line-height: 1.6; }
.action-step-hint { font-size: 11px; color: #999; line-height: 1.6; margin-top: 4px; }

/* M4-2 场景化风险卡 */
.risks-section { margin-bottom: 16px; }
.risk-card {
  background: #fffbf5;
  border: 0.5px solid #f0c060;
  border-radius: 8px;
  padding: 12px 14px;
  margin-top: 8px;
}
.risk-title { font-size: 13px; font-weight: 500; color: #a06000; margin-bottom: 4px; display: block; }
.risk-desc { font-size: 12px; color: #888; line-height: 1.6; margin-bottom: 8px; display: block; }
.risk-question-wrap {
  background: rgba(0,0,0,0.03);
  border-radius: 6px;
  padding: 8px 10px;
}
.risk-q-label { font-size: 10px; color: #bbb; display: block; margin-bottom: 2px; }
.risk-question { font-size: 12px; color: #1a1a1a; line-height: 1.6; }

/* 通用子标题 */
.section-sub-title {
  font-size: 12px;
  font-weight: 500;
  color: #555;
  margin: 16px 0 8px;
  display: block;
}

/* M4-4 验收节点（扩展）*/
.inspection-item-wrap { margin-bottom: 6px; }
.inspection-reason {
  font-size: 11px;
  color: #999;
  line-height: 1.6;
  margin-left: 10px;
  display: block;
  margin-bottom: 2px;
}

/* M4-5 专业审计入口 */
.l2-entry {
  background: #1a1a1a;
  border-radius: 10px;
  padding: 16px;
  margin: 20px 0 8px;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.l2-entry-text {
  font-size: 13px;
  color: rgba(255,255,255,0.7);
  margin-bottom: 4px;
}
.l2-entry-action {
  font-size: 15px;
  font-weight: 500;
  color: #fff;
}