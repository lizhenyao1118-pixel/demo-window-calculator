page { background: #f5f5f0; }

.page { padding: 12px 16px 40px; width: 100%; box-sizing: border-box; overflow: hidden; }

.section-label {
  font-size: 11px;
  color: #999;
  letter-spacing: 0.5px;
  margin: 16px 0 8px;
}

/* TYPE 1 封面 */
.cover-card {
  background: #fff;
  border-radius: 12px;
  border: 0.5px solid rgba(0,0,0,0.08);
  padding: 20px 16px;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.cover-sub { font-size: 11px; color: #999; margin-bottom: 4px; }
.cover-title { font-size: 20px; font-weight: 500; color: #1a1a1a; margin-bottom: 4px; }
.cover-date { font-size: 12px; color: #888; }
.chapter-tabs {
  display: flex;
  flex-direction: row;
  gap: 6px;
  margin-top: 16px;
}
.tab-active {
  background: #e8f0fe;
  color: #3b6bc9;
  font-size: 11px;
  padding: 4px 12px;
  border-radius: 4px;
}
.tab {
  background: #f0f0ec;
  color: #888;
  font-size: 11px;
  padding: 4px 12px;
  border-radius: 4px;
}

/* TYPE 2 参数卡片 */
.param-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 8px;
}
.param-card {
  width: calc(50% - 4px);
  background: #f0f0ec;
  border-radius: 8px;
  padding: 12px;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}
.param-label { font-size: 11px; color: #666; margin-bottom: 4px; }
.param-value { font-size: 28px; font-weight: 500; color: #1a1a1a; line-height: 1.1; }
.param-unit { font-size: 11px; color: #999; margin-top: 2px; }

/* TYPE 3 升级提示 */
.upgrade-block {
  background: #fffbf0;
  border: 0.5px solid #f0c060;
  border-radius: 10px;
  padding: 14px;
  display: flex;
  flex-direction: column;
}
.upgrade-title { font-size: 13px; font-weight: 500; color: #a06000; margin-bottom: 8px; }
.upgrade-item { font-size: 12px; color: #a06000; line-height: 1.8; }
.upgrade-divider {
  height: 0.5px;
  background: #f0c060;
  margin: 10px 0;
}
.upgrade-rec { font-size: 12px; color: #a06000; line-height: 1.8; }

/* TYPE 4 双栏 */
.two-col {
  display: flex;
  flex-direction: row;
  gap: 8px;
}
.col-card {
  flex: 1;
  background: #fff;
  border: 0.5px solid rgba(0,0,0,0.08);
  border-radius: 8px;
  padding: 12px;
  display: flex;
  flex-direction: column;
}
.col-label { font-size: 11px; color: #888; margin-bottom: 6px; }
.col-item { font-size: 12px; color: #1a1a1a; line-height: 1.8; }

/* TYPE 5 表格 */
.table-wrap {
  background: #fff;
  border: 0.5px solid rgba(0,0,0,0.08);
  border-radius: 8px;
  overflow: hidden;
}
.table-head, .table-row {
  display: flex;
  flex-direction: row;
  padding: 8px 12px;
}
.table-head { background: #f0f0ec; }
.table-row { border-top: 0.5px solid rgba(0,0,0,0.06); }
.table-row.alt { background: #fafaf8; }
.col-a { width: 64px; font-size: 11px; color: #888; flex-shrink: 0; }
.col-a.th { font-size: 12px; color: #888; }
.col-b { flex: 1; font-size: 12px; color: #1a1a1a; padding-right: 8px; }
.col-c { width: 56px; font-size: 11px; color: #888; text-align: right; flex-shrink: 0; }
.table-head .col-b, .table-head .col-c { font-size: 11px; color: #888; }

/* TYPE 6 红线清单 */
.redline-list {
  background: #fff;
  border: 0.5px solid rgba(0,0,0,0.08);
  border-radius: 8px;
}
.redline-item {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  padding: 12px 14px;
  border-bottom: 0.5px solid rgba(0,0,0,0.06);
}
.redline-item.no-border { border-bottom: none; }
.redline-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #e05252;
  margin-top: 4px;
  flex-shrink: 0;
  margin-right: 10px;
}
.redline-content { display: flex; flex-direction: column; flex: 1; }
.redline-title { font-size: 13px; font-weight: 500; color: #1a1a1a; margin-bottom: 3px; }
.redline-desc { font-size: 11px; color: #888; line-height: 1.5; }

/* TYPE 7 答题表 */
.qa-form {
  background: #fff;
  border: 0.5px solid rgba(0,0,0,0.08);
  border-radius: 8px;
  padding: 14px;
}
.qa-item { margin-bottom: 14px; }
.qa-item:last-child { margin-bottom: 0; }
.qa-label { font-size: 11px; color: #888; margin-bottom: 6px; display: block; }
.qa-input-mock {
  background: #f5f5f0;
  border-radius: 6px;
  padding: 9px 12px;
}
.qa-placeholder { font-size: 13px; color: #bbb; }
.qa-options { display: flex; flex-direction: row; gap: 8px; margin-top: 4px; }
.qa-opt-active {
  background: #e8f0fe;
  color: #3b6bc9;
  font-size: 12px;
  padding: 6px 16px;
  border-radius: 6px;
}
.qa-opt {
  background: #f0f0ec;
  color: #888;
  font-size: 12px;
  padding: 6px 16px;
  border-radius: 6px;
}

.footer-note {
  text-align: center;
  font-size: 11px;
  color: #ccc;
  margin-top: 24px;
}

/* 付费解锁按钮 */
.unlock-btn {
  background: #07c160;
  border-radius: 10px;
  padding: 16px;
  margin: 20px 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.unlock-btn-text {
  font-size: 16px;
  font-weight: 600;
  color: #fff;
  margin-bottom: 4px;
}
.unlock-btn-sub {
  font-size: 11px;
  color: rgba(255,255,255,0.85);
}

/* 章节标题 */
.chapter-header {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 8px;
  margin: 24px 0 12px;
  padding-bottom: 8px;
  border-bottom: 0.5px solid rgba(0,0,0,0.08);
}
.chapter-num {
  font-size: 11px;
  color: #3b6bc9;
  background: #e8f0fe;
  padding: 2px 8px;
  border-radius: 4px;
}
.chapter-title { font-size: 16px; font-weight: 500; color: #1a1a1a; }

/* 定位说明 */
.position-statement {
  font-size: 12px;
  color: #888;
  line-height: 1.7;
  margin-bottom: 12px;
  display: block;
}

/* 核心参数卡片 */
.param-card-core {
  border: 0.5px solid #3b6bc9;
}

/* 验收节点 */
.inspection-section { margin-bottom: 16px; }
.inspection-phase {
  font-size: 12px;
  font-weight: 500;
  color: #555;
  margin-bottom: 6px;
  display: block;
}
.inspection-item {
  font-size: 12px;
  color: #888;
  line-height: 1.8;
  display: block;
}

/* 付费墙遮罩结构（方案B升级时只需修改此处样式） */
.chapters-wrap { position: relative; }
.chapters-mask {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(255,255,255,0.85);
  z-index: 10;
}

/* 红线清单推荐项灰色圆点 */
.redline-dot-gray {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #bbb;
  margin-top: 4px;
  flex-shrink: 0;
  margin-right: 10px;
}
