/* 引入设计规范变量 */
@import "../../styles/variables.wxss";

.container {
  padding: 0;
  background: var(--color-bg);
  min-height: 100vh;
}

/* Hero区 */
.hero-section {
  background: var(--color-primary);
  color: #FFFFFF;
  padding: 60rpx var(--spacing-module) 40rpx;
  text-align: center;
  position: relative;
}

.page-title {
  font-size: 44rpx;
  font-weight: bold;
  margin-bottom: 24rpx;
}

.identity {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 24rpx;
}

.expert-name {
  font-size: 40rpx;
  font-weight: bold;
}

.expert-role {
  font-weight: normal;
  opacity: 0.9;
}

.stamp {
  display: inline-block;
  border: 4rpx solid #FFFFFF;
  padding: 8rpx 24rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 24rpx;
  letter-spacing: 4rpx;
}

.promise {
  font-size: 28rpx;
  line-height: 1.6;
  opacity: 0.95;
}

/* 主CTA */
.cta-section {
  padding: var(--spacing-module);
}

.btn-primary {
  width: 100%;
  height: 96rpx;
  background: var(--color-primary);
  color: #FFFFFF;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 500;
  letter-spacing: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.btn-primary:active {
  opacity: 0.8;
}

/* 说明区 */
.info-section {
  padding: 0 var(--spacing-module) var(--spacing-module);
}

/* 三步流程 */
.process-steps {
  background: var(--color-card);
  border-radius: var(--radius);
  padding: var(--spacing-inner);
  margin-bottom: var(--spacing-module);
  box-shadow: var(--shadow);
}

.step-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--color-text);
  margin-bottom: 24rpx;
}

.step-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.step-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.step-number {
  width: 48rpx;
  height: 48rpx;
  background: #1B3F72;
  color: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.step-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.step-text {
  font-size: 28rpx;
  color: var(--color-text);
  font-weight: 500;
}

.step-desc {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

/* 历史招标文件快捷卡片 */
.history-section {
  padding: 0 var(--spacing-module) var(--spacing-module);
}

.history-title {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  margin-bottom: 16rpx;
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.history-item {
  background: var(--color-card);
  border-radius: var(--radius);
  padding: var(--spacing-inner);
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: var(--shadow);
}

.history-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.history-city {
  font-size: 28rpx;
  color: var(--color-text);
  font-weight: 500;
}

.history-date {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.history-arrow {
  font-size: 32rpx;
  color: var(--color-text-hint);
}
