<view class="container">
  <!-- Hero区：深蓝底白字 -->
  <view class="hero-section">
    <view class="page-title">门窗诊断与标准</view>
    <view class="identity">
      <text class="expert-name">李Sir</text>
      <text class="expert-role"> · 独立门窗技术顾问</text>
    </view>
    <view class="stamp">不销售 · 不代理</view>
    <view class="promise">让三家商家用同一份标准报价，不懂门窗也能看出谁在偷工减料。</view>
  </view>

  <!-- 主CTA -->
  <view class="cta-section">
    <button class="btn-primary" bindtap="startAssessment">开始定制我的门窗标准</button>
  </view>

  <!-- 说明区 -->
  <view class="info-section">
    <!-- 三步流程 -->
    <view class="process-steps">
      <view class="step-title">使用流程</view>
      <view class="step-list">
        <view class="step-item">
          <view class="step-number">1</view>
          <view class="step-content">
            <text class="step-text">回答9个问题</text>
            <text class="step-desc">关于您家房屋和需求</text>
          </view>
        </view>
        <view class="step-item">
          <view class="step-number">2</view>
          <view class="step-content">
            <text class="step-text">获得招标文件</text>
            <text class="step-desc">专业PDF技术规范</text>
          </view>
        </view>
        <view class="step-item">
          <view class="step-number">3</view>
          <view class="step-content">
            <text class="step-text">发给商家报价</text>
            <text class="step-desc">用同一标准对比价格</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 历史招标文件快捷卡片 -->
  <view class="history-section" wx:if="{{historyList.length > 0}}">
    <view class="history-title">最近生成的招标文件</view>
    <view class="history-list">
      <view class="history-item" wx:for="{{historyList}}" wx:key="id" bindtap="viewReport" data-id="{{item.id}}">
        <view class="history-info">
          <text class="history-city">{{item.city}}</text>
          <text class="history-date">{{item.date}}</text>
        </view>
        <view class="history-arrow">→</view>
      </view>
    </view>
  </view>
</view>
