.container{padding:24rpx}
.loading,.error{padding:40rpx 0;text-align:center;color:#666}
.header{background:#fff;border-radius:12rpx;padding:20rpx;margin-bottom:20rpx}
.id{font-weight:600;display:block;margin-bottom:8rpx}
.meta{color:#666}
.card{background:#fff;border-radius:12rpx;padding:20rpx;margin-bottom:20rpx}
.brand{font-weight:600;display:block}
.contact{color:#666;display:block;margin:6rpx 0}
.time{color:#999;font-size:24rpx}
.rl-title{font-weight:600;margin:10rpx 0}
.redline-item{padding:12rpx;border-radius:10rpx;margin-bottom:10rpx}
.redline-item.hit{background:#fff2f0;border-left:8rpx solid #ff4d4f}
.hit-tag{color:#ff4d4f;font-size:24rpx;margin-left:8rpx}
