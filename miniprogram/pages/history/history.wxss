.container {
  padding: 30rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.header {
  margin-bottom: 40rpx;
  padding: 0 20rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #999;
}

.report-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.report-item {
  background: white;
  padding: 30rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
  border-left: 8rpx solid #07c160;
  position: relative;
}

.report-item.risk {
  border-left-color: #ff4d4f;
  background: #fff2f0;
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.file-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.risk-tag {
  background: #ff4d4f;
  color: white;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.normal-tag {
  background: #e6f7ff;
  color: #1890ff;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.item-meta {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.item-brief {
  font-size: 26rpx;
  color: #666;
  background: #f5f5f5;
  padding: 12rpx;
  border-radius: 8rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.btn-primary {
  background: #07c160;
  color: white;
  width: 400rpx;
  border-radius: 50rpx;
}

.error-tip {
  background: #fff2f0;
  border: 1px solid #ffccc7;
  padding: 30rpx;
  border-radius: 16rpx;
  text-align: center;
  margin: 20rpx;
  color: #ff4d4f;
}

.btn-retry {
  margin-top: 20rpx;
  background: #ff4d4f;
  color: white;
  width: 200rpx;
  font-size: 28rpx;
}

.loading {
  text-align: center;
  padding: 100rpx;
  color: #999;
}