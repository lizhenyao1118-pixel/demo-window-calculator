.container {
  padding: 24rpx;
}

.card {
  background: #fff;
  border-radius: 12rpx;
  padding: 40rpx 24rpx;
  text-align: center;
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  color: #07c160;
}

.desc {
  display: block;
  color: #666;
  font-size: 26rpx;
  line-height: 36rpx;
  margin-bottom: 28rpx;
}

.btn {
  background: #07c160;
  color: #fff;
}
