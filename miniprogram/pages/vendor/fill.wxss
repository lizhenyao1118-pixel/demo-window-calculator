.container {
  padding: 24rpx;
}

.loading {
  padding: 40rpx 0;
  text-align: center;
  color: #666;
}

.error-state {
  padding: 40rpx 0;
  text-align: center;
}

.error-text {
  display: block;
  color: #ff4d4f;
  margin-bottom: 16rpx;
}

.retry-btn {
  width: 220rpx;
}

.tender-header {
  background: #fff;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.tender-id {
  font-weight: 600;
  display: block;
  margin-bottom: 8rpx;
}

.tender-meta {
  font-size: 24rpx;
  color: #666;
}

.section {
  background: #fff;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-weight: 600;
  margin-bottom: 16rpx;
}

.input {
  border: 1px solid #eaeaea;
  border-radius: 10rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
  font-size: 28rpx;
}

.redline-item {
  border-left: 8rpx solid transparent;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
}

.redline-item.red {
  border-left-color: #ff4d4f;
  background: #fff2f0;
}

.redline-item.yellow {
  border-left-color: #faad14;
  background: #fffbe6;
}

.redline-item.green {
  border-left-color: #52c41a;
  background: #f6ffed;
}

.row {
  display: flex;
  align-items: flex-start;
}

.display-id {
  width: 80rpx;
  font-weight: 600;
}

.item-text {
  flex: 1;
  font-size: 26rpx;
  line-height: 36rpx;
  color: #222;
}

.item-switch {
  margin-left: 12rpx;
  transform: scale(0.9);
}

.reason-input {
  margin-top: 12rpx;
}

.textarea {
  width: 100%;
  min-height: 140rpx;
  border: 1px solid #eaeaea;
  border-radius: 10rpx;
  padding: 12rpx;
  box-sizing: border-box;
  font-size: 26rpx;
}

.warning-hint {
  color: #ff4d4f;
  font-size: 24rpx;
  margin-top: 12rpx;
}

.acceptance-item {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
  border-bottom: 1px solid #f2f2f2;
}

.acceptance-item:last-child {
  border-bottom: none;
}

.footer {
  padding: 8rpx 0 40rpx;
}

.save-hint {
  display: block;
  color: #666;
  font-size: 24rpx;
  margin-bottom: 12rpx;
}

.submit-btn {
  background: #07c160;
  color: #fff;
}

.submit-btn.disabled {
  background: #ccc;
  color: #666;
}
