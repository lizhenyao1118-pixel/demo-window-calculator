.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 24rpx;
}

.empty-icon image {
  width: 100%;
  height: 100%;
}

.empty-text {
  color: var(--color-text-secondary);
  font-size: 28rpx;
  text-align: center;
}
