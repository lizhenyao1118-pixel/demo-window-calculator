.badge {
  display: inline-block;
  padding: 8rpx 16rpx;
  border-radius: 4rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.badge.primary {
  background: var(--color-primary-light);
  color: var(--color-primary);
}

.badge.success {
  background: #E8F5E9;
  color: var(--color-success);
}

.badge.warning {
  background: #FFF8E1;
  color: var(--color-warning);
}

.badge.danger {
  background: #FFEBEE;
  color: var(--color-danger);
}

.badge.secondary {
  background: #F5F5F5;
  color: var(--color-text-secondary);
}
