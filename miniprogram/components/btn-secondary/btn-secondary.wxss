.btn-secondary {
  width: 100%;
  height: 96rpx;
  background: #FFFFFF;
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
  border-radius: var(--radius);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 500;
  transition: opacity 0.3s;
}

.btn-secondary.disabled {
  opacity: 0.5;
}
